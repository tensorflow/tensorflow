// RUN: hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_topology_filename=%S/../../../backends/gpu/target_config/specs/gb200_2x4.txtpb | FileCheck %s
// RUN: hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_topology_filename=%S/../../../backends/gpu/target_config/specs/gb300_4x4.txtpb | FileCheck %s
// RUN: hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_topology_filename=1x2x4 --xla_gpu_target_config_filename=%S/../../../backends/gpu/target_config/specs/gb200.txtpb | FileCheck %s
// RUN: hlo-opt %s --platform=CUDA --stage=ptx --xla_gpu_topology_filename=%S/../../../backends/gpu/target_config/specs/gb200_2x4.txtpb | FileCheck %s --check-prefix=CHECK-PTX

HloModule m, num_partitions=1, replica_count=8

add {
  lhs = f32[] parameter(0)
  rhs = f32[] parameter(1)
  ROOT add = f32[] add(lhs, rhs)
}

// CHECK: %[[FUSION_COMPUTATION:.*]] ({{.*}}: f32[1024]) -> f32[1024] {
// CHECK:   %[[P0:.*]] = f32[1024]{0} parameter(0)
// CHECK:   ROOT {{.*}} = f32[1024]{0} all-reduce(%[[P0]])
// CHECK: }
// CHECK: %[[ASYNC_COMPUTATION:.*]] ({{.*}}: f32[1024]) -> f32[1024] {
// CHECK:   %[[ASYNC_P0:.*]] = f32[1024]{0} parameter(0)
// CHECK:   ROOT {{.*}} = f32[1024]{0} fusion(%[[ASYNC_P0]]), kind=kCustom, calls=%[[FUSION_COMPUTATION]], backend_config={{{.*}}"kind":"__triton_collective"
// CHECK: }
// CHECK: ENTRY %main ({{.*}}: f32[1024]) -> f32[1024] {
// CHECK:   %[[P0_ENTRY:.*]] = f32[1024]{0} parameter(0)
// CHECK:   %[[ASYNC_START:.*]] = ((f32[1024]{0}), f32[1024]{0}) async-start(%[[P0_ENTRY]]), calls=%[[ASYNC_COMPUTATION]]
// CHECK:   ROOT {{.*}} = f32[1024]{0} async-done(%[[ASYNC_START]])
// CHECK: }

// CHECK-PTX-LABEL: // GPU Executable
// CHECK-PTX: .target sm_100a
// CHECK-PTX: .visible .entry

ENTRY main {
  p0 = f32[1024] parameter(0)
  ROOT ar = f32[1024] all-reduce(p0), channel_id=1, replica_groups={{0,1,2,3,4,5,6,7}}, use_global_device_ids=true, to_apply=add
}

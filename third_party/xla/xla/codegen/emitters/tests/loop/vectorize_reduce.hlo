// RUN: gpu_fusion_to_mlir %s | emitters_opt -xla-test-optimize \
// RUN:   -xla-gpu-test-transform-loops -xla-lower-tensors | FileCheck %s
// RUN: gpu_test_correctness %s
// RUN: cpu_test_correctness %s

add {
  p0 = f32[] parameter(0)
  p1 = f32[] parameter(1)
  ROOT sum = f32[] add(p0, p1)
}

fusion {
  input = f32[4,131072]{1,0} parameter(0)
  zero = f32[] constant(0)
  ROOT reduce = f32[131072]{0} reduce(input, zero), dimensions={0}, to_apply=add
}

// CHECK-DAG: #xla.indexing_map<"(th_x, bl_x) -> (th_x * 4 + bl_x * 512),
// CHECK-DAG: #xla.indexing_map<"(th_x, bl_x) -> (th_x * 4 + bl_x * 512 + 131072),
// CHECK-DAG: #xla.indexing_map<"(th_x, bl_x) -> (th_x * 4 + bl_x * 512 + 262144),
// CHECK-DAG: #xla.indexing_map<"(th_x, bl_x) -> (th_x * 4 + bl_x * 512 + 393216),
// CHECK-LABEL: func.func @main(
// CHECK-NOT: scf.for
// CHECK-COUNT-4: llvm.load {{.*}} : !llvm.ptr -> vector<4xf32>
// CHECK-NOT: llvm.load {{.*}} : !llvm.ptr -> f32
// CHECK: llvm.store {{.*}} : vector<4xf32>, !llvm.ptr
// CHECK-NOT: scf.for

// RUN: cpu_test_correctness %s

fusion {
  in = f32[20,30] parameter(0)
  updates = f32[5,6] parameter(1)
  i0 = s32[] parameter(2)
  i1 = s32[] parameter(3)
  ROOT updated = f32[20,30] dynamic-update-slice(in, updates, i0, i1)
}

ENTRY main {
  %param_0 = f32[20,30] parameter(0)
  %param_1 = f32[5,6] parameter(1)
  %param_2 = s32[] parameter(2)
  %param_3 = s32[] parameter(3)
  %fusion = f32[20,30] fusion(%param_0, %param_1, %param_2, %param_3), kind=kLoop, calls=fusion
  %neg = f32[20,30] negate(%param_0)
  ROOT %tuple = (f32[20,30], f32[20,30]) tuple(%fusion, %neg)
}

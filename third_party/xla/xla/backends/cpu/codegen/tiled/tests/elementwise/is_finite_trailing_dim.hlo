// RUN: test_correctness %s
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true

fusion {
  p0 = f32[16, 1] parameter(0)
  ROOT is_finite = pred[16, 1] is-finite(p0)
}

ENTRY main {
  p0 = f32[16, 1] parameter(0)
  ROOT fusion = pred[16, 1] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16", "1"]}],
          "num_ctas":"1"
        }
      }
    }
}

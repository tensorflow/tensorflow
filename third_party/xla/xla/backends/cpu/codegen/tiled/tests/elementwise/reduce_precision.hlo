// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  p0 = f32[128, 32] parameter(0)
  ROOT result = f32[128, 32] reduce-precision(p0), exponent_bits=4,
    mantissa_bits=2
}
// CHECK:      #indexing_map = #xla.indexing_map<"(pid, tid) -> (pid * 32 + tid / 8), domain: pid in [0, 3], tid in [0, 255]">
// CHECK:      #indexing_map1 = #xla.indexing_map<"(tid) -> ((tid mod 8) * 4), domain: tid in [0, 255]">

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG:[^:]+]]: memref<128x32xf32>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<128x32xf32>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)
// CHECK-SAME:     attributes {num_opaque_args = 0 : i32}

// CHECK:  %[[C0:.*]] = arith.constant 0 : index
// CHECK:  %[[C1:.*]] = arith.constant 1 : index
// CHECK:  %[[LIMIT:.*]] = arith.constant 256 : index
// CHECK:  scf.for %[[TID:.*]] = %[[C0]] to %[[LIMIT]] step %[[C1]] {
// CHECK:    %[[IDX_0:.*]] = xla.apply_indexing #indexing_map(%[[PID]], %[[TID]])
// CHECK:    %[[IDX_1:.*]] = xla.apply_indexing #indexing_map1(%[[TID]])
// CHECK:    %[[T_0:.*]] = xtile.extract %[[ARG]][%[[IDX_0]], %[[IDX_1]]] [1, 4] [1, 1]
// CHECK:    %[[BITCAST_0:.*]] = tensor.bitcast %[[T_0]] : tensor<1x4xf32> to tensor<1x4xi32>
// CHECK:    %[[SHRUI_0:.*]] = arith.shrui %{{.*}}, %{{.*}} : tensor<1x4xi32>
// CHECK:    %[[BITCAST_1:.*]] = tensor.bitcast %{{.*}} : tensor<1x4xi32> to tensor<1x4xf32>
// CHECK:    xtile.insert %{{.*}} into %[[OUT]][%[[IDX_0]], %[[IDX_1]]] [1, 4] [1, 1] : tensor<1x4xf32> -> memref<128x32xf32>
// CHECK:  }
// CHECK:  xtile.return

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR-SAME:    %[[ARG0:.*]]: memref<128x32xf32>, %[[ARG1:.*]]: memref<128x32xf32>
// CHECK-VECTOR:         %[[PAD:.*]] = arith.constant 0.000000e+00 : f32
// CHECK-VECTOR:         scf.for
// CHECK-VECTOR-NOT:     scf.if
// CHECK-VECTOR:         %[[R0:.*]] = vector.transfer_read %[[ARG0]][%{{.*}}, %{{.*}}], %[[PAD]] {in_bounds = [true]} : memref<128x32xf32>, vector<4xf32>
// CHECK-VECTOR:         %[[CAST_0:.*]] = arith.bitcast %[[R0]] : vector<4xf32> to vector<4xi32>
// CHECK-VECTOR:         %[[SHR_0:.*]] = arith.shrui %{{.*}}, %{{.*}} : vector<4xi32>
// CHECK-VECTOR:         %[[CAST_1:.*]] = arith.bitcast %{{.*}} : vector<4xi32> to vector<4xf32>
// CHECK-VECTOR:         vector.transfer_write %{{.*}}, %[[ARG1]][%{{.*}}, %{{.*}}] {in_bounds = [true]} : vector<4xf32>, memref<128x32xf32>

ENTRY main {
  p0 = f32[128,32] parameter(0)
  ROOT fusion = f32[128,32] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "4"]}],
          "num_ctas":"4"
        }
      }
    }
}

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT: llvm.alloc
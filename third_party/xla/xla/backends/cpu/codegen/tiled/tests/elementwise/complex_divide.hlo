// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  p0 = c64[9] parameter(0)
  p1 = c64[9] parameter(1)
  ROOT divide = c64[9] divide(p0, p1)
}

// CHECK-LABEL: xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[LHS:[^:]+]]: memref<9xcomplex<f32>>,
// CHECK-SAME:     %[[RHS:[^:]+]]: memref<9xcomplex<f32>>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<9xcomplex<f32>>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)

// CHECK:       %[[T_0:.*]] = xtile.extract %[[LHS]]
// CHECK-SAME:    : memref<9xcomplex<f32>> -> tensor<4xcomplex<f32>>
// CHECK:       %[[T_1:.*]] = xtile.extract %[[RHS]]
// CHECK-SAME:    : memref<9xcomplex<f32>> -> tensor<4xcomplex<f32>>
// CHECK:       stablehlo.divide %[[T_0]], %[[T_1]]

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// CHECK-VECTOR-SAME:    %[[LHS:[^:]+]]: memref<9x2xf32>,
// CHECK-VECTOR-SAME:    %[[RHS:[^:]+]]: memref<9x2xf32>,
// CHECK-VECTOR-SAME:    %[[OUT:[^:]+]]: memref<9x2xf32>,
// CHECK-VECTOR-SAME:    %[[PID:[^:]+]]: index)

// CHECK-VECTOR:       vector.transfer_read %[[LHS]]
// CHECK-VECTOR:       vector.transfer_read %[[RHS]]
// CHECK-VECTOR:       arith.divf

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT: llvm.alloc

ENTRY main {
  constant.1 = c64[9]{0} constant({
    (1, 1),     (1, inf),   (1, inf),   (nan, 1),
    (inf, inf), (inf, nan), (nan, nan), (1, 2), (1, -1)})
  real = f32[9]{0} constant({nan, nan, inf, inf, inf, 1, inf, 3, 0})
  imag = f32[9]{0} constant({inf, inf, inf, inf, 1, inf, inf, 4, 0})
  complex.2 = c64[9]{0} complex(real, imag)
  ROOT fusion = c64[9] fusion(constant.1, complex.2), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["4"]}],
          "num_ctas":"1"
        }
      }
    }
}

// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: test_correctness %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true

fusion {
  p0 = pred[128,256] parameter(0)
  p1 = c64[128,256] parameter(1)
  p2 = c64[128,256] parameter(2)
  ROOT select = c64[128,256] select(p0, p1, p2)
}

// CHECK-LABEL: xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[COND:[^:]+]]: memref<128x256xi8>,
// CHECK-SAME:     %[[ON_TRUE:[^:]+]]: memref<128x256xcomplex<f32>>,
// CHECK-SAME:     %[[ON_FALSE:[^:]+]]: memref<128x256xcomplex<f32>>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<128x256xcomplex<f32>>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)

// CHECK:       %[[T_0:.*]] = xtile.extract %[[COND]]
// CHECK-SAME:    : memref<128x256xi8> -> tensor<1x4xi8>
// CHECK:       %[[T_1:.*]] = xtile.extract %[[ON_TRUE]]
// CHECK-SAME:    : memref<128x256xcomplex<f32>> -> tensor<1x4xcomplex<f32>>
// CHECK:       %[[T_2:.*]] = xtile.extract %[[ON_FALSE]]
// CHECK-SAME:    : memref<128x256xcomplex<f32>> -> tensor<1x4xcomplex<f32>>
// CHECK:       arith.select {{.*}}, %[[T_1]], %[[T_2]]

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// CHECK-VECTOR:   arith.select

// NEW-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// NEW-VECTOR-SAME:    %[[COND:[^:]+]]: memref<128x256xi8>,
// NEW-VECTOR-SAME:    %[[ON_TRUE:[^:]+]]: memref<128x256x2xf32>,
// NEW-VECTOR-SAME:    %[[ON_FALSE:[^:]+]]: memref<128x256x2xf32>,
// NEW-VECTOR-SAME:    %[[OUT:[^:]+]]: memref<128x256x2xf32>,
// NEW-VECTOR-SAME:    %[[PID:[^:]+]]: index)

// NEW-VECTOR:       vector.transfer_read %[[COND]]
// NEW-VECTOR:       vector.transfer_read %[[ON_TRUE]]
// NEW-VECTOR:       vector.transfer_read %[[ON_FALSE]]
// NEW-VECTOR:       arith.select

ENTRY main {
  p0 = pred[128,256] parameter(0)
  p1 = c64[128,256] parameter(1)
  p2 = c64[128,256] parameter(2)
  ROOT fusion = c64[128,256] fusion(p0, p1, p2), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "4"]}],
          "num_ctas":"4"
        }
      }
    }
}

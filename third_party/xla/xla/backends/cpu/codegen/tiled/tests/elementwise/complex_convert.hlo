// RUN: test_correctness %s
// RUN: test_correctness %s

fusion {
  p0 = f32[128,256] parameter(0)
  ROOT convert = c64[128,256] convert(p0)
}

ENTRY main {
  p0 = f32[128,256] parameter(0)
  ROOT fusion = c64[128,256] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "4"]}],
          "num_ctas":"4"
        }
      }
    }
}

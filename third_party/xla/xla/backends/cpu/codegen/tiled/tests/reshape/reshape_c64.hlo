// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   --xtile-cpu-vector-to-llvm | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xtile-cpu-new-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR-LLVM
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true

fusion {
  p0 = c64[128,256] parameter(0)
  ROOT reshape = c64[32768] reshape(p0)
}
// CHECK: #[[MAP0:.*]] = #xla.indexing_map<"(pid, tid) -> (pid * 32 + tid / 64), domain: pid in [0, 3], tid in [0, 2047]">
// CHECK: #[[MAP1:.*]] = #xla.indexing_map<"(tid) -> ((tid mod 64) * 4), domain: tid in [0, 2047]">
// CHECK: #[[MAP2:.*]] = #xla.indexing_map<"(pid, tid) -> (pid * 8192 + tid * 4), domain: pid in [0, 3], tid in [0, 2047]">

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG:[^:]+]]: memref<128x256xcomplex<f32>>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<32768xcomplex<f32>>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)

// CHECK:  %[[C0:.*]] = arith.constant 0 : index
// CHECK:  %[[C1:.*]] = arith.constant 1 : index
// CHECK:  %[[LIMIT:.*]] = arith.constant 2048 : index
// CHECK:  scf.for %[[TID:.*]] = %[[C0]] to %[[LIMIT]] step %[[C1]] {
// CHECK:    %[[IDX_0:.*]] = xla.apply_indexing #[[MAP0]](%[[PID]], %[[TID]])
// CHECK:    %[[IDX_1:.*]] = xla.apply_indexing #[[MAP1]](%[[TID]])
// CHECK:    %[[T_0:.*]] = xtile.extract %[[ARG]][%[[IDX_0]], %[[IDX_1]]] [1, 4] [1, 1]
// CHECK:    %[[RESHAPE:.*]] = stablehlo.reshape %[[T_0]]
// CHECK-SAME:  : (tensor<1x4xcomplex<f32>>) -> tensor<4xcomplex<f32>>
// CHECK:    %[[IDX_2:.*]] = xla.apply_indexing #[[MAP2]](%[[PID]], %[[TID]])
// CHECK:    xtile.insert %[[RESHAPE]] into %[[OUT]][%[[IDX_2]]] [4] [1]

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR:         %[[ALLOCA_0:.*]] = memref.alloca() : memref<1x4xcomplex<f32>>
// CHECK-VECTOR:         %[[ALLOCA_1:.*]] = memref.alloca() : memref<1x4xcomplex<f32>>
// CHECK-VECTOR:         memref.copy %{{.*}}, %[[ALLOCA_0]]

// NEW-VECTOR-LABEL: func.func @wrapped_fusion_impl
// NEW-VECTOR-SAME:    %[[ARG0:.*]]: memref<128x256x2xf32>,
// NEW-VECTOR-SAME:    %[[ARG1:.*]]: memref<32768x2xf32>

// NEW-VECTOR:         %[[PAD:.*]] = arith.constant 0.000000e+00 : f32
// NEW-VECTOR:         scf.for
// NEW-VECTOR:         %[[R0:.*]] = vector.transfer_read %[[ARG0]]
// NEW-VECTOR:         %[[CAST:.*]] = vector.shape_cast %[[R0]] : vector<1x4x2xf32> to vector<4x2xf32>
// NEW-VECTOR:         vector.transfer_write %[[CAST]], %[[ARG1]]

// CHECK-LLVM: llvm.intr.memcpy
// NEW-VECTOR-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl

ENTRY main {
  p0 = c64[128,256] parameter(0)
  ROOT fusion = c64[32768] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["4"]}],
          "num_ctas":"4"
        }
      }
    }
}

// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | FileCheck %s
// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xtile-cpu-new-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR-LLVM
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering

fusion {
  p0 = f32[] parameter(0)
  p1 = f32[128,64] parameter(1)
  c0 = f32[] constant(1.0)
  ROOT clamp = f32[128,64] clamp(p0, p1, c0)
}

ENTRY main {
  p0 = f32[] parameter(0)
  p1 = f32[128,64] parameter(1)
  ROOT fusion = f32[128,64] fusion(p0, p1), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["4", "4"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG0:[^:]+]]: memref<f32>,
// CHECK-SAME:     %[[ARG1:[^:]+]]: memref<128x64xf32>,
// CHECK-SAME:     %[[ARG2:[^:]+]]: memref<128x64xf32>,
// CHECK-SAME:     %{{.*}}: index {xla.range = [0 : index, 0 : index]})

// CHECK:        scf.for %[[IDX:.*]] = %{{.*}} to %{{.*}} step %{{.*}} {
// CHECK-DAG:      %[[MIN_SCALAR:.*]] = xtile.extract %[[ARG0]][] [] [] : memref<f32> -> tensor<f32>
// CHECK-DAG:      %[[VAL:.*]] = xtile.extract %[[ARG1]][%{{.*}}, %{{.*}}] [4, 4] [1, 1] : memref<128x64xf32> -> tensor<4x4xf32>
// CHECK-DAG:      %[[MAX_SCALAR:.*]] = arith.constant dense<1.000000e+00> : tensor<f32>
// CHECK-DAG:      %[[MIN_BCAST:.*]] = stablehlo.broadcast_in_dim %[[MIN_SCALAR]], dims = [] : (tensor<f32>) -> tensor<4x4xf32>
// CHECK-DAG:      %[[MAX_BCAST:.*]] = stablehlo.broadcast_in_dim %[[MAX_SCALAR]], dims = [] : (tensor<f32>) -> tensor<4x4xf32>
// CHECK:          %[[MAX_OP:.*]] = stablehlo.maximum %[[MIN_BCAST]], %[[VAL]] : tensor<4x4xf32>
// CHECK:          %[[MIN_OP:.*]] = stablehlo.minimum %[[MAX_OP]], %[[MAX_BCAST]] : tensor<4x4xf32>
// CHECK:          xtile.insert %[[MIN_OP]] into %[[ARG2]][%{{.*}}, %{{.*}}] [4, 4] [1, 1] : tensor<4x4xf32> -> memref<128x64xf32>

// NEW-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// NEW-VECTOR-SAME:    %[[ARG0:[^:]+]]: memref<f32>,
// NEW-VECTOR-SAME:    %[[ARG1:[^:]+]]: memref<128x64xf32>,
// NEW-VECTOR-SAME:    %[[ARG2:[^:]+]]: memref<128x64xf32>,
// NEW-VECTOR:         scf.for
// NEW-VECTOR-DAG:       %[[READ_MIN:.*]] = vector.transfer_read %[[ARG0]][], %{{.*}} : memref<f32>, vector<f32>
// NEW-VECTOR-DAG:       %[[BCAST_MIN:.*]] = vector.broadcast %[[READ_MIN]] : vector<f32> to vector<4x4xf32>
// NEW-VECTOR-DAG:       %[[READ_VAL:.*]] = vector.transfer_read %[[ARG1]][%{{.*}}, %{{.*}}], %{{.*}} {in_bounds = [true, true]} : memref<128x64xf32>, vector<4x4xf32>
// NEW-VECTOR:           %[[MAX:.*]] = arith.maximumf %[[BCAST_MIN]], %[[READ_VAL]] : vector<4x4xf32>
// NEW-VECTOR:           %[[MIN:.*]] = arith.minimumf %[[MAX]], %{{.*}} : vector<4x4xf32>
// NEW-VECTOR:           vector.transfer_write %[[MIN]], %[[ARG2]][%{{.*}}, %{{.*}}] {in_bounds = [true, true]} : vector<4x4xf32>, memref<128x64xf32>

// NEW-VECTOR-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// NEW-VECTOR-LLVM-NOT: llvm.alloc

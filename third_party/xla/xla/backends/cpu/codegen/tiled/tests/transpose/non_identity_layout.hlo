// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: test_correctness %s
fusion {
  p0 = f32[100,3,70]{0,1,2} parameter(0)
  ROOT transpose = f32[3,100,70]{0,2,1} transpose(p0), dimensions={1,0,2}
}
ENTRY main {
  p0 = f32[100,3,70]{0,1,2} parameter(0)
  ROOT fusion = f32[3,100,70]{0,2,1} fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16", "8", "4"]}],
          "num_ctas":"1"
        }
      }
    }
}
// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// CHECK-VECTOR-SAME:    %[[ARG0:[^:]+]]: memref<100x3x70xf32, #xtile.layout<[0, 1, 2]>>,
// CHECK-VECTOR-SAME:    %[[ARG1:[^:]+]]: memref<3x100x70xf32, #xtile.layout<[0, 2, 1]>>,

// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   --xtile-cpu-vector-to-llvm | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xtile-cpu-new-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR-LLVM
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true

fusion {
  %param_0 = bf16[1,256,56,56]{3,2,1,0} parameter(0)
  %convert = f32[1,256,56,56]{3,2,1,0} convert(%param_0)
  %transpose = f32[1,56,56,256]{2,1,3,0} transpose(%convert), dimensions={0,2,3,1}
  ROOT %copy = f32[1,56,56,256]{3,2,1,0} copy(%transpose)
}

// CHECK:      #indexing_map = #xla.indexing_map<"(pid) -> (min(pid * -1046 + 12544, 1046)), domain: pid in [0, 11]">
// CHECK:      #indexing_map1 = #xla.indexing_map<"(pid, tid) -> (((pid * 1046 + tid) mod 32) * 8), domain: pid in [0, 11], tid in [0, 1045]">
// CHECK:      #indexing_map2 = #xla.indexing_map<"(pid, tid) -> (((pid * 1046 + tid) / 224) mod 56), domain: pid in [0, 11], tid in [0, 1045]">
// CHECK:      #indexing_map3 = #xla.indexing_map<"(pid, tid) -> ((((pid * 1046 + tid) / 32) mod 7) * 8), domain: pid in [0, 11], tid in [0, 1045]">

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG0:[^:]+]]: memref<1x256x56x56xbf16>,
// CHECK-SAME:     %[[ARG1:[^:]+]]: memref<1x56x56x256xf32>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)

// CHECK:        %[[C0:.*]] = arith.constant 0 : index
// CHECK:        %[[C1:.*]] = arith.constant 1 : index
// CHECK:        %[[UB:.*]] = xla.apply_indexing #indexing_map(%[[PID]])
// CHECK:        scf.for %[[TID:.*]] = %[[C0]] to %[[UB]] step %[[C1]] {
// CHECK:          %[[IDX1:.*]] = xla.apply_indexing #indexing_map1(%[[PID]], %[[TID]])
// CHECK:          %[[IDX2:.*]] = xla.apply_indexing #indexing_map2(%[[PID]], %[[TID]])
// CHECK:          %[[IDX3:.*]] = xla.apply_indexing #indexing_map3(%[[PID]], %[[TID]])
// CHECK:          %[[EXT:.*]] = xtile.extract %[[ARG0]][%[[C0]], %[[IDX1]], %[[IDX2]], %[[IDX3]]] [1, 8, 1, 8] [1, 1, 1, 1] : memref<1x256x56x56xbf16> -> tensor<1x8x1x8xbf16>
// CHECK:          %[[CONV:.*]] = stablehlo.convert %[[EXT]] : (tensor<1x8x1x8xbf16>) -> tensor<1x8x1x8xf32>
// CHECK:          %[[TRANS:.*]] = stablehlo.transpose %[[CONV]], dims = [0, 2, 3, 1] : (tensor<1x8x1x8xf32>) -> tensor<1x1x8x8xf32>
// CHECK:          xtile.insert %[[TRANS]] into %[[ARG1]][%[[C0]], %[[IDX2]], %[[IDX3]], %[[IDX1]]] [1, 1, 8, 8] [1, 1, 1, 1] : tensor<1x1x8x8xf32> -> memref<1x56x56x256xf32>
// CHECK:        }
// CHECK:        xtile.return

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR:         %[[ALLOCA_0:.*]] = memref.alloca() : memref<1x8x1x8xbf16>
// CHECK-VECTOR:         %[[ALLOCA_1:.*]] = memref.alloca() : memref<1x8x1x8xbf16>
// CHECK-VECTOR:         %[[ALLOCA_2:.*]] = memref.alloca() alignment = 64 : memref<1x1x8x8xf32>
// CHECK-VECTOR:         scf.for
// CHECK-VECTOR:           memref.copy
// CHECK-VECTOR:           scf.for
// CHECK-VECTOR:             vector.transfer_read
// CHECK-VECTOR:             arith.extf
// CHECK-VECTOR:             vector.transfer_write
// CHECK-VECTOR:           memref.copy

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM:         llvm.alloca

// NEW-VECTOR-LABEL: func.func @wrapped_fusion_impl
// NEW-VECTOR:         %[[PAD:.*]] = arith.constant 0 : i16
// NEW-VECTOR:         %[[IN:.*]] = xtile.memref_bitcast %{{.*}} : memref<1x256x56x56xbf16> -> memref<1x256x56x56xi16>
// NEW-VECTOR:         scf.for
// NEW-VECTOR:           %[[READ:.*]] = vector.transfer_read %[[IN]][%{{.*}}], %[[PAD]] {in_bounds = [true, true, true, true]} : memref<1x256x56x56xi16>, vector<1x8x1x8xi16>
// NEW-VECTOR:           %[[CAST:.*]] = arith.bitcast %[[READ]] : vector<1x8x1x8xi16> to vector<1x8x1x8xbf16>
// NEW-VECTOR:           %[[EXT:.*]] = arith.extf %[[CAST]] : vector<1x8x1x8xbf16> to vector<1x8x1x8xf32>
// NEW-VECTOR:           %[[TRANS:.*]] = vector.transpose %[[EXT]], [0, 2, 3, 1] : vector<1x8x1x8xf32> to vector<1x1x8x8xf32>
// NEW-VECTOR:           vector.transfer_write %[[TRANS]], %{{.*}}[%{{.*}}] {in_bounds = [true, true, true, true]} : vector<1x1x8x8xf32>, memref<1x56x56x256xf32>

// NEW-VECTOR-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// NEW-VECTOR-LLVM-NOT:     llvm.alloca
// NEW-VECTOR-LLVM-COUNT-8: llvm.load %{{.*}} <alignment = 2> : !llvm.ptr -> vector<8xi16>
// NEW-VECTOR-LLVM:         llvm.shufflevector
// NEW-VECTOR-LLVM-COUNT-8: llvm.store %{{.*}}, %{{.*}} <alignment = 4> : vector<8xf32>, !llvm.ptr

ENTRY %main {
  %input = bf16[1,256,56,56]{3,2,1,0} parameter(0)
  ROOT %fusion = f32[1,56,56,256]{3,2,1,0} fusion(%input), kind=kLoop, calls=%fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "1", "8", "8"]}],
          "num_ctas":"12"
        }
      }
    }
}

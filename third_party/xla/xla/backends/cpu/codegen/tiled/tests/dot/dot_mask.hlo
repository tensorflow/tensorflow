// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s \
// RUN:   --abs_error_bound=1e-4 --rel_error_bound=1e-6

fusion {
  p0 = f32[3,17,33] parameter(0)
  p1 = f32[3,33,9] parameter(1)
  p1_exp = f32[3,33,9] exponential(p1)
  ROOT dot = f32[3,17,9] dot(p0, p1_exp),
    lhs_batch_dims={0}, rhs_batch_dims={0},
    lhs_contracting_dims={2}, rhs_contracting_dims={1},
    backend_config={sizes:[4]}

}

// CHECK-VECTOR: wrapped_fusion

// CHECK-VECTOR:      %[[LHS:.*]] = vector.transfer_read %{{.*}} : memref<3x17x33xf32>, vector<2x4x4xf32>
// CHECK-VECTOR:      %[[RHS:.*]] = vector.transfer_read %{{.*}} : memref<3x33x9xf32>, vector<2x4x4xf32>
// CHECK-VECTOR:      vector.contract {indexing_maps = [{{.*}}], iterator_types = ["parallel", "reduction", "parallel", "parallel"], kind = #vector.kind<add>} %{{.*}}, %{{.*}}, %{{.*}} : vector<2x4x4xf32>, vector<2x4x4xf32> into vector<2x4x4xf32>
// CHECK-VECTOR:      vector.transfer_write %{{.*}}, %{{.*}} : vector<2x4x4xf32>, memref<3x17x9xf32>

ENTRY main {
  p0 = f32[3,17,33] parameter(0)
  p1 = f32[3,33,9] parameter(1)
  ROOT fusion = f32[3,17,9] fusion(p0, p1), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["2", "4", "4"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT: llvm.alloc

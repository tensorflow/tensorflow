// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s \
// RUN:   --abs_error_bound=0 --rel_error_bound=0

fusion {
  p0 = u8[64,32] parameter(0)
  p1 = u8[32] parameter(1)
  ROOT dot = u8[64] dot(p0, p1),
    lhs_contracting_dims={1}, rhs_contracting_dims={0},
    backend_config={sizes:[8]}
}

// CHECK-VECTOR: wrapped_fusion
// CHECK-VECTOR: vector.transfer_read %{{.*}} : memref<64x32xi8>, vector<8x8xi8>
// CHECK-VECTOR: vector.transfer_read %{{.*}} : memref<32xi8>, vector<8xi8>
// CHECK-VECTOR: vector.contract {indexing_maps = [{{.*}}], iterator_types = ["reduction", "parallel"], kind = #vector.kind<add>} %{{.*}}, %{{.*}}, %{{.*}} : vector<8x8xi8>, vector<8xi8> into vector<8xi8>
// CHECK-VECTOR: vector.transfer_write %{{.*}} : vector<8xi8>, memref<64xi8>

ENTRY main {
  p0 = u8[64,32] parameter(0)
  p1 = u8[32] parameter(1)
  ROOT fusion = u8[64] fusion(p0, p1), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["8"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT: llvm.alloc

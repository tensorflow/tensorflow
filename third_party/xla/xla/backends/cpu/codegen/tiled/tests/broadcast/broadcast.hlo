// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering \
// RUN:   | fusion_compiler_opt --canonicalize -cse | FileCheck %s
// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xtile-cpu-new-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR-LLVM
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering

fusion {
  p0 = f32[32] parameter(0)
  ROOT broadcast = f32[8,32] broadcast(p0), dimensions={1}
}

ENTRY main {
  p0 = f32[32] parameter(0)
  ROOT fusion = f32[8,32] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["8", "16"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG0:[^:]+]]: memref<32xf32>,
// CHECK-SAME:     %[[ARG1:[^:]+]]: memref<8x32xf32>,
// CHECK-SAME:     %{{.*}}: index)

// CHECK:        scf.for %[[IDX:.*]] = %{{.*}} to %{{.*}} step %{{.*}} {
// CHECK:          %[[OFF1:.*]] = xla.apply_indexing
// CHECK:          %[[EXT:.*]] = xtile.extract %[[ARG0]][%[[OFF1]]] [16] [1]
// CHECK:          %[[BCAST:.*]] = stablehlo.broadcast_in_dim %[[EXT]], dims = [1]
// CHECK:          xtile.insert %[[BCAST]] into %[[ARG1]][%{{.*}}, %[[OFF1]]] [8, 16] [1, 1]

// NEW-VECTOR:    scf.for %[[IDX:.*]] = %{{.*}} to %{{.*}} step %{{.*}} {
// NEW-VECTOR-NOT:  scf.if
// NEW-VECTOR:      %[[EXT:.*]] = vector.transfer_read %{{.*}}[%{{.*}}], %{{.*}} {in_bounds = [true]} : memref<32xf32>, vector<16xf32>
// NEW-VECTOR:      %[[BCAST:.*]] = vector.broadcast %[[EXT]] : vector<16xf32> to vector<8x16xf32>
// NEW-VECTOR:      vector.transfer_write %[[BCAST]], %{{.*}}[%{{.*}}, %{{.*}}] {in_bounds = [true, true]} : vector<8x16xf32>, memref<8x32xf32>

// NEW-VECTOR-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// NEW-VECTOR-LLVM-NOT: llvm.alloc

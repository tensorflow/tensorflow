// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xtile-cpu-new-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR-LLVM
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering \
// RUN:   --abs_error_bound=1e-4 --rel_error_bound=1e-6

fusion {
  p0 = f32[128,256] parameter(0)
  p1 = f32[256,64] parameter(1)
  ROOT dot = f32[128,64] dot(p0, p1),
   lhs_contracting_dims={1}, rhs_contracting_dims={0},
   backend_config={sizes:[32]}
}

// NEW-VECTOR: wrapped_fusion

// NEW-VECTOR: %[[RHS:.*]] = vector.transfer_read %{{.*}} : memref<256x64xf32>, vector<32x8xf32>
// NEW-VECTOR: vector.contract {indexing_maps = [{{.*}}], iterator_types = ["reduction", "parallel", "parallel"], kind = #vector.kind<add>} %{{.*}}, %[[RHS]], %{{.*}} : vector<8x32xf32>, vector<32x8xf32> into vector<8x8xf32>
// NEW-VECTOR: vector.transfer_write %{{.*}} : vector<8x8xf32>, memref<128x64xf32>

ENTRY main {
  p0 = f32[128,256] parameter(0)
  p1 = f32[256,64] parameter(1)
  ROOT fusion = f32[128,64] fusion(p0, p1), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["8", "8"]}],
          "num_ctas":"1"
        }
      }
    }
}

// NEW-VECTOR-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// NEW-VECTOR-LLVM-NOT: llvm.alloc

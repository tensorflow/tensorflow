// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xtile-cpu-new-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR-LLVM
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true

fusion {
  p0 = f32[128,256] parameter(0)
  ROOT is_finite = pred[128,256] is-finite(p0)
}
// CHECK:      #indexing_map = #xla.indexing_map<"(pid, tid) -> ((tid / 64) * 8 + pid * 64), domain: pid in [0, 1], tid in [0, 511]">
// CHECK:      #indexing_map1 = #xla.indexing_map<"(tid) -> ((tid mod 64) * 4), domain: tid in [0, 511]">

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG:[^:]+]]: memref<128x256xf32>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<128x256xi8>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)
// CHECK-SAME:     attributes {num_opaque_args = 0 : i32}

// CHECK:  %[[C0:.*]] = arith.constant 0 : index
// CHECK:  %[[C1:.*]] = arith.constant 1 : index
// CHECK:  %[[LIMIT:.*]] = arith.constant 512 : index
// CHECK:  scf.for %[[TID:.*]] = %[[C0]] to %[[LIMIT]] step %[[C1]] {
// CHECK:    %[[IDX_0:.*]] = xla.apply_indexing #indexing_map(%[[PID]], %[[TID]])
// CHECK:    %[[IDX_1:.*]] = xla.apply_indexing #indexing_map1(%[[TID]])
// CHECK:    %[[T_0:.*]] = xtile.extract %[[ARG]][%[[IDX_0]], %[[IDX_1]]] [8, 4] [1, 1]
// CHECK:    %[[FIN:.*]] = math.isfinite %[[T_0]] : tensor<8x4xf32>
// CHECK:    %[[CONV:.*]] = stablehlo.convert %[[FIN]] : (tensor<8x4xi1>) -> tensor<8x4xi8>
// CHECK:    xtile.insert %[[CONV]] into %[[OUT]][%[[IDX_0]], %[[IDX_1]]] [8, 4] [1, 1]
// CHECK:  }
// CHECK:  xtile.return

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR:  %[[ALLOCA_0:.*]] = memref.alloca() : memref<8x4xf32>
// CHECK-VECTOR:  %[[ALLOCA_1:.*]] = memref.alloca() {{{.*}}} : memref<8x4xi8>
// CHECK-VECTOR:  memref.copy %{{.*}}, %[[ALLOCA_0]]
// CHECK-VECTOR:  memref.copy %{{.*}}, %{{.*}}

// NEW-VECTOR-LABEL: func.func @wrapped_fusion_impl
// NEW-VECTOR-SAME:    %[[ARG0:.*]]: memref<128x256xf32>, %[[ARG1:.*]]: memref<128x256xi8>
// NEW-VECTOR:         %[[PAD:.*]] = arith.constant 0.000000e+00 : f32
// NEW-VECTOR:         scf.for
// NEW-VECTOR-NOT:     scf.if
// NEW-VECTOR:         %[[R0:.*]] = vector.transfer_read %[[ARG0]][%{{.*}}, %{{.*}}], %[[PAD]] {in_bounds = [true, true]} : memref<128x256xf32>, vector<8x4xf32>
// NEW-VECTOR:         %[[FIN:.*]] = math.isfinite %[[R0]] : vector<8x4xf32>
// NEW-VECTOR:         %[[CAST:.*]] = arith.extui %[[FIN]] : vector<8x4xi1> to vector<8x4xi8>
// NEW-VECTOR:         vector.transfer_write %[[CAST]], %[[ARG1]][%{{.*}}, %{{.*}}] {in_bounds = [true, true]} : vector<8x4xi8>, memref<128x256xi8>

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM:         llvm.load
// CHECK-LLVM:         llvm.store

// NEW-VECTOR-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// NEW-VECTOR-LLVM-NOT: llvm.alloc

ENTRY main {
  p0 = f32[128,256] parameter(0)
  ROOT fusion = pred[128,256] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["8", "4"]}],
          "num_ctas":"2"
        }
      }
    }
}

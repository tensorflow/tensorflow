// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  ROOT iota = f32[128,256] iota(), iota_dimension=1
}

ENTRY main {
  ROOT fusion = f32[128,256] fusion(), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["8", "4"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK:      xtile.entry_func @wrapped_fusion(
// CHECK-SAME:   %[[OUT:[^:]+]]: memref<128x256xf32>,
// CHECK-SAME:   %[[PID:[^:]+]]: index)
// CHECK:        %[[IOTA:.*]] = stablehlo.iota dim = 0 : tensor<4xi32>
// CHECK:        %[[CONV:.*]] = stablehlo.convert %{{.*}} : (tensor<4xi32>) -> tensor<4xf32>
// CHECK:        %[[BCAST:.*]] = stablehlo.broadcast_in_dim %[[CONV]], dims = [1] : (tensor<4xf32>) -> tensor<8x4xf32>
// CHECK:        xtile.insert %[[BCAST]] into %[[OUT]][%{{.*}}] [8, 4] [1, 1] : tensor<8x4xf32> -> memref<128x256xf32>

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR:         %[[SITOFP:.*]] = arith.sitofp %{{.*}} : vector<4xi32> to vector<4xf32>
// CHECK-VECTOR:         %[[BCAST:.*]] = vector.broadcast %[[SITOFP]] : vector<4xf32> to vector<8x4xf32>
// CHECK-VECTOR:         vector.transfer_write %[[BCAST]], %{{.*}} : vector<8x4xf32>, memref<128x256xf32>

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT: llvm.alloc

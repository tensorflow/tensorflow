// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s \
// RUN:   --abs_error_bound=1e-4 --rel_error_bound=1e-6

fusion {
  p0 = f32[2,16,32] parameter(0)
  p1 = f32[2,32,8] parameter(1)
  ROOT dot = f32[2,16,8] dot(p0, p1),
    lhs_batch_dims={0}, rhs_batch_dims={0},
    lhs_contracting_dims={2}, rhs_contracting_dims={1},
    backend_config={sizes:[8]}
}

// CHECK-VECTOR: wrapped_fusion

// CHECK-VECTOR:      %[[LHS:.*]] = vector.transfer_read %{{.*}} : memref<2x16x32xf32>, vector<4x8xf32>
// CHECK-VECTOR:      %[[RHS:.*]] = vector.transfer_read %{{.*}} : memref<2x32x8xf32>, vector<8x4xf32>
// CHECK-VECTOR:      %[[CAST_IN:.*]] = vector.shape_cast {{.*}} : vector<1x4x4xf32> to vector<4x4xf32>
// CHECK-VECTOR:      %[[RES:.*]] = vector.contract {indexing_maps = [{{.*}}], iterator_types = ["reduction", "parallel", "parallel"], kind = #vector.kind<add>} %[[LHS]], %[[RHS]], %[[CAST_IN]] : vector<4x8xf32>, vector<8x4xf32> into vector<4x4xf32>
// CHECK-VECTOR:      %[[CAST_OUT:.*]] = vector.shape_cast %[[RES]] : vector<4x4xf32> to vector<1x4x4xf32>

ENTRY main {
  p0 = f32[2,16,32] parameter(0)
  p1 = f32[2,32,8] parameter(1)
  ROOT fusion = f32[2,16,8] fusion(p0, p1), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "4", "4"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT: llvm.alloc

// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering \
// RUN:   --abs_error_bound=1e-4 --rel_error_bound=1e-6

fusion {
  p0 = f32[2,16,32] parameter(0)
  p1 = f32[2,32,8] parameter(1)
  ROOT dot = f32[2,16,8] dot(p0, p1),
    lhs_batch_dims={0}, rhs_batch_dims={0},
    lhs_contracting_dims={2}, rhs_contracting_dims={1},
    backend_config={sizes:[8]}
}

// NEW-VECTOR: wrapped_fusion

// NEW-VECTOR:      %[[LHS:.*]] = vector.transfer_read %{{.*}} : memref<2x16x32xf32>, vector<1x4x8xf32>
// NEW-VECTOR:      %[[RHS:.*]] = vector.transfer_read %{{.*}} : memref<2x32x8xf32>, vector<1x8x4xf32>
// NEW-VECTOR:      vector.contract {indexing_maps = [{{.*}}], iterator_types = ["parallel", "reduction", "parallel", "parallel"], kind = #vector.kind<add>} %[[LHS]], %[[RHS]], %{{.*}} : vector<1x4x8xf32>, vector<1x8x4xf32> into vector<1x4x4xf32>
// NEW-VECTOR:      vector.transfer_write %{{.*}}, %{{.*}} : vector<1x4x4xf32>, memref<2x16x8xf32>

ENTRY main {
  p0 = f32[2,16,32] parameter(0)
  p1 = f32[2,32,8] parameter(1)
  ROOT fusion = f32[2,16,8] fusion(p0, p1), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "4", "4"]}],
          "num_ctas":"1"
        }
      }
    }
}
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  %param_0 = f32[400,17]{1,0} parameter(0)
  %bitcast.0 = f32[50,2,4,17]{3,2,1,0} bitcast(%param_0)
  %transpose = f32[2,17,4,50]{1,2,0,3} transpose(%bitcast.0),
    dimensions={1,3,2,0}
  %copy = f32[2,17,4,50]{3,2,1,0} copy(%transpose)
  ROOT %bitcast.1 = f32[136,50]{1,0} bitcast(%copy)
}

ENTRY main {
  p0 = f32[400,17]{1,0} parameter(0)
  ROOT fusion = f32[136,50] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "8"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// CHECK-VECTOR:         scf.for
// CHECK-VECTOR:           memref.alloca
// CHECK-VECTOR:           scf.for
// CHECK-VECTOR:             memref.load %arg0
// CHECK-VECTOR:             memref.store %{{.*}}, %alloca
// CHECK-VECTOR:           vector.transfer_read
// CHECK-VECTOR:           vector.transfer_write

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM:         llvm.alloca
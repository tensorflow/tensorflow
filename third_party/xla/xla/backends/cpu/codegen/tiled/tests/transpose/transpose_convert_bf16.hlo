// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xtile-cpu-new-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR-LLVM
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true

// The output side of an NHWC -> NCHW layout change in bf16, as emitted around a
// depthwise convolution. The convert happens before the transpose, so without
// help the 16x16 transpose shuffles bf16 vectors, which x86 scalarizes into one
// `__truncsfbf2` libcall per element. The transpose only moves data, so it must
// run on i16 instead.

fusion {
  p0 = f32[1,56,56,256]{3,2,1,0} parameter(0)
  c = bf16[1,56,56,256]{3,2,1,0} convert(p0)
  t = bf16[1,256,56,56]{1,3,2,0} transpose(c), dimensions={0,3,1,2}
  ROOT copy = bf16[1,256,56,56]{3,2,1,0} copy(t)
}

// NEW-VECTOR-LABEL: func.func @wrapped_fusion_impl
// NEW-VECTOR:         %[[OUT:.*]] = xtile.memref_bitcast %{{.*}} : memref<1x256x56x56xbf16> -> memref<1x256x56x56xi16>
// NEW-VECTOR:         %[[TRUNC:.*]] = arith.truncf %{{.*}} : vector<1x1x16x16xf32> to vector<1x1x16x16xbf16>
// NEW-VECTOR:         %[[CAST:.*]] = arith.bitcast %[[TRUNC]] : vector<1x1x16x16xbf16> to vector<1x1x16x16xi16>
// NEW-VECTOR:         %[[T:.*]] = vector.transpose %[[CAST]], [0, 3, 1, 2] : vector<1x1x16x16xi16> to vector<1x16x1x16xi16>
// NEW-VECTOR:         vector.transfer_write %[[T]], %[[OUT]]

// The transpose shuffles and all memory accesses are on i16. The only bf16
// vectors left join the two halves produced by the 8-wide truncation intrinsic
// right before the bitcast, which LLVM keeps in registers.
// NEW-VECTOR-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// NEW-VECTOR-LLVM-NOT:     llvm.shufflevector {{.*}}[0, 16, 1, 17, {{.*}}bf16>
// NEW-VECTOR-LLVM:         llvm.shufflevector {{.*}}[0, 16, 1, 17, {{.*}} : vector<16xi16>
// NEW-VECTOR-LLVM-NOT:     llvm.shufflevector {{.*}}[0, 16, 1, 17, {{.*}}bf16>
// NEW-VECTOR-LLVM-NOT:     llvm.store {{.*}}bf16>
// NEW-VECTOR-LLVM-NOT:     llvm.intr.masked.store {{.*}}bf16>

ENTRY main {
  p0 = f32[1,56,56,256]{3,2,1,0} parameter(0)
  ROOT fusion = bf16[1,256,56,56]{3,2,1,0} fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "16", "1", "16"]}],
          "num_ctas":"12"
        }
      }
    }
}

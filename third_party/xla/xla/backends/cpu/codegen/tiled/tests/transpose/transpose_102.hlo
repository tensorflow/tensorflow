// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: test_correctness %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true

fusion {
  p0 = f32[100,3,70] parameter(0)
  ROOT transpose = f32[3,100,70] transpose(p0), dimensions={1,0,2}
}

ENTRY main {
  p0 = f32[100,3,70] parameter(0)
  ROOT fusion = f32[3,100,70] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16", "8", "4"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK:      #indexing_map = #xla.indexing_map<"(tid) -> ((tid / 18) * 8), domain: tid in [0, 233]">
// CHECK:      #indexing_map1 = #xla.indexing_map<"(tid) -> ((tid mod 18) * 4), domain: tid in [0, 233]">

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG0:[^:]+]]: memref<100x3x70xf32>,
// CHECK-SAME:     %[[ARG1:[^:]+]]: memref<3x100x70xf32>,
// CHECK-SAME:     %{{.*}}: index)

// CHECK:        %[[C0:.*]] = arith.constant 0 : index
// CHECK:        scf.for %[[IDX:.*]] = %{{.*}} to %{{.*}} step %{{.*}} {
// CHECK:          %[[OFF0:.*]] = xla.apply_indexing #indexing_map(%[[IDX]])
// CHECK:          %[[OFF2:.*]] = xla.apply_indexing #indexing_map1(%[[IDX]])
// CHECK:          %[[EXT:.*]] = xtile.extract %[[ARG0]][%[[OFF0]], %[[C0]], %[[OFF2]]] [8, 16, 4] [1, 1, 1]
// CHECK:          %[[TRANS:.*]] = stablehlo.transpose %[[EXT]], dims = [1, 0, 2]
// CHECK:          xtile.insert %[[TRANS]] into %[[ARG1]][%[[C0]], %[[OFF0]], %[[OFF2]]] [16, 8, 4] [1, 1, 1]

// NEW-VECTOR:    %[[C3:.*]] = arith.constant 3 : index
// NEW-VECTOR:    %[[C0:.*]] = arith.constant 0 : index
// NEW-VECTOR:    scf.for %[[IDX:.*]] = %{{.*}} to %{{.*}} step %{{.*}} {
// NEW-VECTOR:      %[[OFF0:.*]] = xla.apply_indexing
// NEW-VECTOR:      %[[OFF2:.*]] = xla.apply_indexing
// NEW-VECTOR:      %[[M0:.*]] = arith.maxsi
// NEW-VECTOR:      %[[M2:.*]] = arith.maxsi
// NEW-VECTOR:      %[[MASK_READ:.*]] = vector.create_mask %[[M0]], %[[C3]], %[[M2]] : vector<8x16x4xi1>
// NEW-VECTOR:      %[[EXT:.*]] = vector.transfer_read %{{.*}}[%[[OFF0]], %[[C0]], %[[OFF2]]], %{{.*}}, %[[MASK_READ]] : memref<100x3x70xf32>, vector<8x16x4xf32>
// NEW-VECTOR:      %[[TRANS:.*]] = vector.transpose %[[EXT]], [1, 0, 2] : vector<8x16x4xf32> to vector<16x8x4xf32>
// NEW-VECTOR:      %[[MASK_WRITE:.*]] = vector.create_mask %[[C3]], %[[M0]], %[[M2]] : vector<16x8x4xi1>
// NEW-VECTOR:      vector.transfer_write %[[TRANS]], %{{.*}}[%[[C0]], %[[OFF0]], %[[OFF2]]], %[[MASK_WRITE]] : vector<16x8x4xf32>, memref<3x100x70xf32>

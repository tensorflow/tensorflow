// RUN: fusion_to_xtile %s | FileCheck %s
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  p0 = s32[] parameter(0)
  ROOT broadcast = s32[128,64] broadcast(p0), dimensions={}
}

ENTRY main {
  p0 = s32[] parameter(0)
  ROOT fusion = s32[128,64] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["4", "4"]}],
          "num_ctas":"1"
        }
      }
    }
}

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG0:[^:]+]]: memref<i32>,
// CHECK-SAME:     %[[ARG1:[^:]+]]: memref<128x64xi32>,
// CHECK-SAME:     %{{.*}}: index)

// CHECK:        scf.for %[[IDX:.*]] = %{{.*}} to %{{.*}} step %{{.*}} {
// CHECK:          %[[EXT:.*]] = xtile.extract %[[ARG0]][] [] [] : memref<i32> -> tensor<i32>
// CHECK:          %[[BCAST:.*]] = stablehlo.broadcast_in_dim %[[EXT]], dims = [] : (tensor<i32>) -> tensor<4x4xi32>
// CHECK:          xtile.insert %[[BCAST]] into %[[ARG1]][%{{.*}}, %{{.*}}] [4, 4] [1, 1] : tensor<4x4xi32> -> memref<128x64xi32>

// CHECK-VECTOR:    func.func @wrapped_fusion_impl(
// CHECK-VECTOR-SAME: %[[ARG0:[^:]+]]: memref<i32>,
// CHECK-VECTOR-SAME: %[[ARG1:[^:]+]]: memref<128x64xi32>,
// CHECK-VECTOR-SAME: %{{.*}}: index)
// CHECK-VECTOR:      scf.for %[[IDX:.*]] = %{{.*}} to %{{.*}} step %{{.*}} {
// CHECK-VECTOR:        %[[READ:.*]] = vector.transfer_read %[[ARG0]][], %{{.*}} : memref<i32>, vector<i32>
// CHECK-VECTOR:        %[[BCAST:.*]] = vector.broadcast %[[READ]] : vector<i32> to vector<4x4xi32>
// CHECK-VECTOR-NOT:    scf.if
// CHECK-VECTOR:        vector.transfer_write %[[BCAST]], %[[ARG1]][%{{.*}}, %{{.*}}] {in_bounds = [true, true]} : vector<4x4xi32>, memref<128x64xi32>

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT: llvm.alloc

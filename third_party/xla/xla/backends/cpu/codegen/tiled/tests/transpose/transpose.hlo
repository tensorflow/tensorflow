// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: test_correctness %s

fusion {
  p0 = f32[16,40,40,64]{3,2,1,0} parameter(0)
  transpose = f32[64,40,40,16]{0,2,1,3} transpose(p0), dimensions={3,1,2,0}
  ROOT copy = f32[64,40,40,16]{3,2,1,0} copy(transpose)
}

ENTRY main {
  p0 = f32[16,40,40,64]{3,2,1,0} parameter(0)
  ROOT fusion = f32[64,40,40,16]{3,2,1,0} fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16", "1", "1", "16"]}],
          "num_ctas":"8"
        }
      }
    }
}

// CHECK:      #indexing_map = #xla.indexing_map<"(pid, tid) -> ((pid mod 2) * 20 + tid / 40), domain: pid in [0, 7], tid in [0, 799]">
// CHECK:      #indexing_map1 = #xla.indexing_map<"(tid) -> (tid mod 40), domain: tid in [0, 799]">
// CHECK:      #indexing_map2 = #xla.indexing_map<"(pid) -> ((pid / 2) * 16), domain: pid in [0, 7]">

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG0:[^:]+]]: memref<16x40x40x64xf32>,
// CHECK-SAME:     %[[ARG1:[^:]+]]: memref<64x40x40x16xf32>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)

// CHECK:        %[[C0:.*]] = arith.constant 0 : index
// CHECK:        %[[C1:.*]] = arith.constant 1 : index
// CHECK:        %[[LIMIT:.*]] = arith.constant 800 : index
// CHECK:        scf.for %[[TID:.*]] = %[[C0]] to %[[LIMIT]] step %[[C1]] {
// CHECK:          %[[IDX0:.*]] = xla.apply_indexing #indexing_map(%[[PID]], %[[TID]])
// CHECK:          %[[IDX1:.*]] = xla.apply_indexing #indexing_map1(%[[TID]])
// CHECK:          %[[IDX2:.*]] = xla.apply_indexing #indexing_map2(%[[PID]])
// CHECK:          %[[EXT:.*]] = xtile.extract %[[ARG0]][%[[C0]], %[[IDX0]], %[[IDX1]], %[[IDX2]]] [16, 1, 1, 16] [1, 1, 1, 1]
// CHECK:          %[[TRANS:.*]] = stablehlo.transpose %[[EXT]], dims = [3, 1, 2, 0]
// CHECK:          xtile.insert %[[TRANS]] into %[[ARG1]][%[[IDX2]], %[[IDX0]], %[[IDX1]], %[[C0]]] [16, 1, 1, 16] [1, 1, 1, 1]
// CHECK:        }
// CHECK:        xtile.return

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector="prefer_vector_width=256" \
// RUN:   --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  p0 = f32[2, 16] parameter(0)
  ROOT convert = bf16[2, 16] convert(p0)
}

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR-NOT:     scf.if
// CHECK-VECTOR:         vector.transfer_read {{.*}} {in_bounds = [true, true]} : memref<2x16xf32>, vector<1x16xf32>
// CHECK-VECTOR:         vector.transfer_write {{.*}} {in_bounds = [true, true]} : vector<1x16xi16>, memref<2x16xi16>

// CHECK-LLVM:       llvm.func @wrapped_fusion(%{{.*}}) -> !llvm.ptr
// CHECK-LLVM-SAME:    "prefer-vector-width", "256"
// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM:         %[[LOAD:.*]] = llvm.load %{{.*}} <alignment = 4> : !llvm.ptr -> vector<16xf32>
// CHECK-LLVM:         llvm.call @xla.fptrunc.v16f32.to.v16bf16(%[[LOAD]]) : (vector<16xf32>) -> vector<16xbf16>
// CHECK-LLVM:         llvm.store %{{.*}}, %{{.*}} <alignment = 2> : vector<16xi16>, !llvm.ptr

ENTRY main {
  p0 = f32[2, 16] parameter(0)
  ROOT fusion = bf16[2, 16] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "16"]}],
          "num_ctas":"2"
        }
      }
    }
}
// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: test_correctness %s


fusion {
  p0 = c64[16,40,40,64]{3,2,1,0} parameter(0)
  transpose = c64[64,40,40,16]{0,2,1,3} transpose(p0), dimensions={3,1,2,0}
  ROOT copy = c64[64,40,40,16]{3,2,1,0} copy(transpose)
}

// CHECK: #[[MAP0:.*]] = #xla.indexing_map<"(pid, tid) -> ((pid mod 2) * 20 + tid / 40), domain: pid in [0, 7], tid in [0, 799]">
// CHECK: #[[MAP1:.*]] = #xla.indexing_map<"(tid) -> (tid mod 40), domain: tid in [0, 799]">
// CHECK: #[[MAP2:.*]] = #xla.indexing_map<"(pid) -> ((pid / 2) * 16), domain: pid in [0, 7]">

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG:[^:]+]]: memref<16x40x40x64xcomplex<f32>>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<64x40x40x16xcomplex<f32>>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)
// CHECK-SAME:     attributes {num_opaque_args = 0 : i32}

// CHECK-DAG:  %[[C0:.*]] = arith.constant 0 : index
// CHECK-DAG:  %[[C1:.*]] = arith.constant 1 : index

// CHECK:  %[[LIMIT:.*]] = arith.constant 800 : index
// CHECK:  scf.for %[[TID:.*]] = %[[C0]] to %[[LIMIT]] step %[[C1]] {
// CHECK:    %[[IDX_0:.*]] = xla.apply_indexing #[[MAP0]](%[[PID]], %[[TID]])
// CHECK:    %[[IDX_1:.*]] = xla.apply_indexing #[[MAP1]](%[[TID]])
// CHECK:    %[[IDX_2:.*]] = xla.apply_indexing #[[MAP2]](%[[PID]])
// CHECK:    %[[T_0:.*]] = xtile.extract %[[ARG]][%[[C0]], %[[IDX_0]], %[[IDX_1]], %[[IDX_2]]] [16, 1, 1, 16] [1, 1, 1, 1]
// CHECK:    %[[TRANSPOSE:.*]] = stablehlo.transpose %[[T_0]], dims = [3, 1, 2, 0] : (tensor<16x1x1x16xcomplex<f32>>) -> tensor<16x1x1x16xcomplex<f32>>
// CHECK:    xtile.insert %[[TRANSPOSE]] into %[[OUT]][%[[IDX_2]], %[[IDX_0]], %[[IDX_1]], %[[C0]]] [16, 1, 1, 16] [1, 1, 1, 1]

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR-SAME:    %[[ARG0:.*]]: memref<16x40x40x64x2xf32>, %[[ARG1:.*]]: memref<64x40x40x16x2xf32>

// CHECK-VECTOR: %[[PAD:.*]] = arith.constant 0.000000e+00 : f32
// CHECK-VECTOR: scf.for
// CHECK-VECTOR: vector.transfer_read %[[ARG0]][%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}], %[[PAD]] {{.*}} : memref<16x40x40x64x2xf32>, vector<16x1x1x16x2xf32>
// CHECK-VECTOR: %[[TRANSPOSE:.*]] = vector.transpose %{{.*}}, [3, 1, 2, 0, 4] : vector<16x1x1x16x2xf32> to vector<16x1x1x16x2xf32>
// CHECK-VECTOR: vector.transfer_write %[[TRANSPOSE]], %[[ARG1]][%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}] {{.*}} : vector<16x1x1x16x2xf32>, memref<64x40x40x16x2xf32>

ENTRY main {
  p0 = c64[16,40,40,64]{3,2,1,0} parameter(0)
  ROOT fusion = c64[64,40,40,16]{3,2,1,0} fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16", "1", "1", "16"]}],
          "num_ctas":"8"
        }
      }
    }
}

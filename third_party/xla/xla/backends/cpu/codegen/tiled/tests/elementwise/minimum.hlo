// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   --xtile-cpu-vector-to-llvm | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  p0 = f32[128,256] parameter(0)
  p1 = f32[128,256] parameter(1)
  ROOT minimum = f32[128,256] minimum(p0, p1)
}
// CHECK:      #indexing_map = #xla.indexing_map<"(pid, tid) -> (pid * 32 + tid / 64), domain: pid in [0, 3], tid in [0, 2047]">
// CHECK:      #indexing_map1 = #xla.indexing_map<"(tid) -> ((tid mod 64) * 4), domain: tid in [0, 2047]">

// CHECK:        xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[LHS:[^:]+]]: memref<128x256xf32>,
// CHECK-SAME:     %[[RHS:[^:]+]]: memref<128x256xf32>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<128x256xf32>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)
// CHECK-SAME:     attributes {num_opaque_args = 0 : i32}

// CHECK:  %[[C0:.*]] = arith.constant 0 : index
// CHECK:  %[[C1:.*]] = arith.constant 1 : index
// CHECK:  %[[LIMIT:.*]] = arith.constant 2048 : index
// CHECK:  scf.for %[[TID:.*]] = %[[C0]] to %[[LIMIT]] step %[[C1]] {
// CHECK:    %[[IDX_0:.*]] = xla.apply_indexing #indexing_map(%[[PID]], %[[TID]])
// CHECK:    %[[IDX_1:.*]] = xla.apply_indexing #indexing_map1(%[[TID]])
// CHECK:    %[[T_0:.*]] = xtile.extract %[[LHS]][%[[IDX_0]], %[[IDX_1]]] [1, 4] [1, 1]
// CHECK:    %[[T_1:.*]] = xtile.extract %[[RHS]][%[[IDX_0]], %[[IDX_1]]] [1, 4] [1, 1]
// CHECK:    %[[MIN:.*]] = stablehlo.minimum %[[T_0]], %[[T_1]] : tensor<1x4xf32>
// CHECK:    xtile.insert %[[MIN]] into %[[OUT]][%[[IDX_0]], %[[IDX_1]]] [1, 4] [1, 1]
// CHECK:  }
// CHECK:  xtile.return

// CHECK-VECTOR: vector.transfer_write
// CHECK-LLVM: llvm.intr.memcpy

ENTRY main {
  p0 = f32[128,256] parameter(0)
  p1 = f32[128,256] parameter(1)
  ROOT fusion = f32[128,256] fusion(p0, p1), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "4"]}],
          "num_ctas":"4"
        }
      }
    }
}
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  p0 = f32[10] parameter(0)
  ROOT pad = f32[3] slice(p0), slice={[1:6:2]}
}

ENTRY main {
  p0 = f32[10] parameter(0)
  ROOT fusion = f32[3] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16"]}],
          "num_ctas":"1"
        }
      }
    }
}
// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// CHECK-VECTOR:           %[[CST:.*]] = arith.constant dense<0.000000e+00> : vector<16xf32>
// CHECK-VECTOR-COUNT-5:   memref.load {{.*}} : memref<10xf32>
// CHECK-VECTOR-NOT:       memref.load
// CHECK-VECTOR:           %[[MASK:.*]] = vector.constant_mask [3] : vector<16xi1>
// CHECK-VECTOR:           vector.transfer_write 
// CHECK-VECTOR-SAME:        %[[MASK]] : vector<16xf32>, memref<3xf32>

// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT:   llvm.alloca
// CHECK-LLVM:       llvm.intr.masked.store


// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: test_correctness %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xtile-cpu-new-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR-LLVM
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true

fusion {
  p0 = f32[10] parameter(0)
  ROOT pad = f32[3] slice(p0), slice={[1:6:2]}
}

ENTRY main {
  p0 = f32[10] parameter(0)
  ROOT fusion = f32[3] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16"]}],
          "num_ctas":"1"
        }
      }
    }
}
// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR:         memref.subview %{{.*}}[1] [5] [2]
// CHECK-VECTOR:         memref.copy
// CHECK-VECTOR:         memref.copy

// NEW-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// NEW-VECTOR:           %[[CST:.*]] = arith.constant dense<0.000000e+00> : vector<16xf32>
// NEW-VECTOR-COUNT-5:   memref.load {{.*}} : memref<10xf32>
// NEW-VECTOR-NOT:       memref.load
// NEW-VECTOR:           %[[MASK:.*]] = vector.constant_mask [3] : vector<16xi1>
// NEW-VECTOR:           vector.transfer_write 
// NEW-VECTOR-SAME:        %[[MASK]] : vector<16xf32>, memref<3xf32>

// NEW-VECTOR-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// NEW-VECTOR-LLVM-NOT:   llvm.alloca
// NEW-VECTOR-LLVM:       llvm.intr.masked.store


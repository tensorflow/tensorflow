// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xtile-cpu-vector-to-llvm \
// RUN:   | FileCheck %s --check-prefix=CHECK-LLVM
// RUN: test_correctness %s

fusion {
  param_0 = f32[2,1,2,1]{3,1,0,2} parameter(0)
  copy_0 = f32[2,1,2,1]{3,2,1,0} copy(param_0)
  transpose = f32[2,2,1,1]{3,0,2,1} transpose(copy_0), dimensions={2,0,1,3}
  copy_1 = f32[2,2,1,1]{3,2,1,0} copy(transpose)
  ROOT bitcast = f32[2,2]{1,0} bitcast(copy_1)
}

ENTRY main {
  param_0 = f32[2,1,2,1]{3,1,0,2} parameter(0)
  ROOT fusion = f32[2,2]{1,0} fusion(param_0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["2", "2"]}],
          "num_ctas":"1"
        }
      }
    }
}
// CHECK-LLVM-LABEL: llvm.func internal @wrapped_fusion_impl
// CHECK-LLVM-NOT: llvm.alloc

// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s

// RUN: fusion_to_xtile %s | fusion_compiler_opt \
// RUN:   --xtile-cpu-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: test_correctness %s




// CHECK-LABEL: xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG:[^:]+]]: memref<1x9xf16>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<1x9xi8>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)

// CHECK:       %[[T_0:.*]] = xtile.extract %[[ARG]]
// CHECK-SAME:    : memref<1x9xf16> -> tensor<1x16xf16>
// CHECK:       %[[T_1:.*]] = math.isfinite %[[T_0]]
// CHECK-SAME:    : tensor<1x16xf16>
// CHECK:       %[[T_2:.*]] = stablehlo.convert %[[T_1]]
// CHECK-SAME:    : (tensor<1x16xi1>) -> tensor<1x16xi8>
// CHECK:       xtile.insert %[[T_2]] into %[[OUT]]
// CHECK-SAME:    : tensor<1x16xi8> -> memref<1x9xi8>

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl
// CHECK-VECTOR-SAME:    %[[ARG:[^:]+]]: memref<1x9xf16>, %[[OUT:[^:]+]]: memref<1x9xi8>, %[[PID:[^:]+]]: index
// CHECK-VECTOR:         %[[MASK:.*]] = vector.constant_mask [9] : vector<16xi1>
// CHECK-VECTOR:         %[[READ:.*]] = vector.transfer_read %[[ARG]]{{.*}}, %[[MASK]] : memref<1x9xf16>, vector<16xf16>
// CHECK-VECTOR:         %[[FINITE:.*]] = math.isfinite %[[READ]] : vector<16xf16>
// CHECK-VECTOR:         %[[CAST:.*]] = arith.extui %[[FINITE]] : vector<16xi1> to vector<16xi8>
// CHECK-VECTOR:         vector.transfer_write %[[CAST]], %[[OUT]]{{.*}}, %[[MASK]] : vector<16xi8>, memref<1x9xi8>

fusion {
  p0 = f16[1, 9] parameter(0)
  ROOT is_finite = pred[1, 9] is-finite(p0)
}

ENTRY main {
  p0 = f16[1, 9] parameter(0)
  ROOT fusion = pred[1, 9] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "16"]}],
          "num_ctas":"1"
        }
      }
    }
}

// RUN: fusion_to_xtile %s | fusion_compiler_opt --canonicalize -cse \
// RUN:   | FileCheck %s
// RUN: fusion_to_xtile %s | fusion_compiler_opt --xtile-cpu-xtile-to-vector \
// RUN:   | FileCheck %s --check-prefix=CHECK-VECTOR
// RUN: test_correctness %s

// RUN: fusion_to_xtile %s --xla_cpu_use_new_xtile_lowering | fusion_compiler_opt \
// RUN:   --xtile-cpu-new-xtile-to-vector --xla-simplify-arith \
// RUN:   | FileCheck %s --check-prefix=NEW-VECTOR
// RUN: test_correctness %s --xla_cpu_use_new_xtile_lowering=true




// CHECK-LABEL: xtile.entry_func @wrapped_fusion(
// CHECK-SAME:     %[[ARG:[^:]+]]: memref<1x9xf16>,
// CHECK-SAME:     %[[OUT:[^:]+]]: memref<1x9xi8>,
// CHECK-SAME:     %[[PID:[^:]+]]: index)

// CHECK:       %[[T_0:.*]] = xtile.extract %[[ARG]]
// CHECK-SAME:    : memref<1x9xf16> -> tensor<1x16xf16>
// CHECK:       %[[T_1:.*]] = math.isfinite %[[T_0]]
// CHECK-SAME:    : tensor<1x16xf16>
// CHECK:       %[[T_2:.*]] = stablehlo.convert %[[T_1]]
// CHECK-SAME:    : (tensor<1x16xi1>) -> tensor<1x16xi8>
// CHECK:       xtile.insert %[[T_2]] into %[[OUT]]
// CHECK-SAME:    : tensor<1x16xi8> -> memref<1x9xi8>

// CHECK-VECTOR-LABEL: func.func @wrapped_fusion_impl(
// CHECK-VECTOR-SAME:     %[[ARG:[^:]+]]: memref<1x9xf16>,
// CHECK-VECTOR-SAME:     %[[OUT:[^:]+]]: memref<1x9xi8>,
// CHECK-VECTOR-SAME:     %[[PID:[^:]+]]: index)
// CHECK-VECTOR:        %[[ALLOCA_ARG:.*]] = memref.alloca() : memref<1x16xf16>
// CHECK-VECTOR:        %[[ALLOCA_OUT:.*]] = memref.alloca() {{{.*}}} : memref<1x16xi8>
// CHECK-VECTOR:        memref.copy %[[ARG]],
// CHECK-VECTOR:        scf.for
// CHECK-VECTOR:          %[[READ:.*]] = vector.transfer_read %[[ALLOCA_ARG]]{{.*}} : memref<1x16xf16>, vector<8xf16>
// CHECK-VECTOR:          %[[FINITE:.*]] = math.isfinite %[[READ]] : vector<8xf16>
// CHECK-VECTOR:          %[[CAST:.*]] = arith.extui %[[FINITE]] : vector<8xi1> to vector<8xi8>
// CHECK-VECTOR:          vector.transfer_write %[[CAST]], %[[ALLOCA_OUT]]{{.*}} : vector<8xi8>, memref<1x16xi8>
// CHECK-VECTOR:        memref.copy %{{.*}}, %[[OUT]]

// NEW-VECTOR-LABEL: func.func @wrapped_fusion_impl
// NEW-VECTOR-SAME:    %[[ARG:[^:]+]]: memref<1x9xf16>, %[[OUT:[^:]+]]: memref<1x9xi8>, %[[PID:[^:]+]]: index
// NEW-VECTOR:         %[[MASK:.*]] = vector.constant_mask [1, 9] : vector<1x16xi1>
// NEW-VECTOR:         %[[READ:.*]] = vector.transfer_read %[[ARG]]{{.*}}, %[[MASK]]{{.*}} : memref<1x9xf16>, vector<1x16xf16>
// NEW-VECTOR:         %[[FINITE:.*]] = math.isfinite %[[READ]] : vector<1x16xf16>
// NEW-VECTOR:         %[[CAST:.*]] = arith.extui %[[FINITE]] : vector<1x16xi1> to vector<1x16xi8>
// NEW-VECTOR:         vector.transfer_write %[[CAST]], %[[OUT]]{{.*}}, %[[MASK]]{{.*}} : vector<1x16xi8>, memref<1x9xi8>

fusion {
  p0 = f16[1, 9] parameter(0)
  ROOT is_finite = pred[1, 9] is-finite(p0)
}

ENTRY main {
  p0 = f16[1, 9] parameter(0)
  ROOT fusion = pred[1, 9] fusion(p0), kind=kLoop, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["1", "16"]}],
          "num_ctas":"1"
        }
      }
    }
}

// RUN: gpu_fusion_to_mlir %s | emitters_opt -xla-test-optimize |\
// RUN:   FileCheck %s
// RUN: gpu_test_correctness %s

fusion {
  %param_0 = s4[128, 256, 8, 32]{3,2,1,0:E(4)} parameter(0)
  ROOT %transpose= s4[128, 32, 8, 256]{3,2,1,0:E(4)} transpose(%param_0),
    dimensions={0,3,2,1}
}
// CHECK: #indexing_map{{.*}}domain:{{.*}}th_x in [0, 255]
// CHECK: %thread_id_x = gpu.thread_id  x {xla.range = [0 : index, 255 : index]}
// CHECK: xla_gpu.allocate_shared : tensor<256x256xi4>
// CHECK: vector.bitcast {{.*}} : vector<8xi4> to vector<1xi32>
// CHECK: arith.andi {{.*}} : i32
// CHECK: arith.shli {{.*}} : i32
// CHECK: arith.ori {{.*}} : i32
// CHECK: arith.shrui {{.*}} : i32
// CHECK: vector.bitcast {{.*}} : vector<1xi32> to vector<8xi4>

// RUN: gpu_fusion_to_mlir %s | emitters_opt -xla-test-optimize |\
// RUN:   FileCheck %s
// RUN: gpu_test_correctness %s

fusion {
  p0 = s8[8,64,68] parameter(0)
  ROOT transpose = s8[8,68,64] transpose(p0), dimensions={0, 2, 1}
}
// CHECK: #indexing_map{{.*}}domain:{{.*}}th_x in [0, 255]
// CHECK: %thread_id_x = gpu.thread_id  x {xla.range = [0 : index, 255 : index]}
// CHECK:  xla_gpu.allocate_shared : tensor<128x128xi8>
// CHECK: vector.bitcast {{.*}} : vector<4xi8> to vector<1xi32>
// CHECK: arith.andi {{.*}} : i32
// CHECK: arith.shli {{.*}} : i32
// CHECK: arith.ori {{.*}} : i32
// CHECK: arith.shrui {{.*}} : i32
// CHECK: vector.bitcast {{.*}} : vector<1xi32> to vector<4xi8>

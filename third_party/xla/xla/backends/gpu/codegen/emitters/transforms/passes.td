#ifndef XLA_SERVICE_GPU_FUSIONS_TRANSFORMS_PASSES_TD_
#define XLA_SERVICE_GPU_FUSIONS_TRANSFORMS_PASSES_TD_

include "mlir/Pass/PassBase.td"

def ConvertIndexTypePass : Pass<"xla-gpu-convert-index-type", "mlir::ModuleOp"> {
  let summary = "Converts index types to module data layout index type.";

  let description = [{
      Converts types of arith ops that are potentially generated by indexing
      maps to integers of module's data layout index size. That is necessary
      because some of the backends either want to stop supporting arithmetic ops
      on IndexType or hardcode 32-bits for their LLVM lowering, which might be
      not sufficient.
  }];

  let dependentDialects = [
    "mlir::arith::ArithDialect",
  ];
}

def ConvertFloatNvidiaPass : Pass<"xla-gpu-convert-float-nvidia", "mlir::ModuleOp"> {
  let summary = "Convert floating point types using NVPTX intrinsics.";

  let dependentDialects = [
    "mlir::LLVM::LLVMDialect",
    "mlir::arith::ArithDialect",
  ];
  let options = [
    Option<"compute_capability_major_", "compute_capability_major", "int", /*default=*/"0",
           "CUDA compute capability major version.">,
    Option<"compute_capability_minor_", "compute_capability_minor", "int", /*default=*/"0",
           "CUDA compute capability minor version.">,
    Option<"ptx_version_major_", "ptx_version_major", "int", /*default=*/"0",
           "PTX version major.">,
    Option<"ptx_version_minor_", "ptx_version_minor", "int", /*default=*/"0",
           "PTX version minor.">
  ];
}

def ConvertFloatAMDPass : Pass<"xla-gpu-convert-float-amd", "mlir::ModuleOp"> {
  let summary = "Convert floating point types using AMDGCN intrinsics.";

  let dependentDialects = [
    "mlir::LLVM::LLVMDialect",
    "mlir::arith::ArithDialect",
  ];
  let options = [
    Option<"gpu_device_info_", "gpu_device_info", "std::string", /*default=*/"",
           "Serialized stream_executor::GPUDeviceInfo proto.">,
  ];
}
def RecoverExp2Pass : Pass<"xla-gpu-recover-exp2", "mlir::ModuleOp"> {
  let summary = "Recovers exp2(x) from exp(x*log(2))";

  let dependentDialects = [
    "mlir::LLVM::LLVMDialect",
    "mlir::arith::ArithDialect",
    "mlir::math::MathDialect",
  ];
}

def PeelLoopsPass : Pass<"xla-gpu-peel-loops", "mlir::func::FuncOp"> {
  let summary = "Peels xla_gpu.loop.";
  let description = [{
      Attempts to split each loop dimension [0, NUM_ITERATIONS)
      as [0, NUM_ITERATIONS - 1) and [NUM_ITERATIONS - 1, NUM_ITERATIONS)
      if it removes a constraint.
  }];
  let dependentDialects = ["xla::gpu::XlaGpuDialect", "xla::XlaDialect"];
}

def OptimizeLoopsPass :
   Pass<"xla-gpu-optimize-loops", "mlir::func::FuncOp"> {
  let summary = "Unrolls and pipelines loops.";

  let description = [{
    Unrolls loops with a small trip count. Pipelines loops with a large trip
    count.
  }];

  let dependentDialects = [
    "mlir::vector::VectorDialect",
    "xla::gpu::XlaGpuDialect",
    "xla::XlaDialect",
  ];

  let options = [
    Option<"max_unroll_factor_", "max_unroll_factor", "int", /*default=*/"0",
           "Maximum unroll factor.">
  ];
}


def LowerXlaSharedPass :
   Pass<"xla-gpu-lower-xla-shared", "mlir::func::FuncOp"> {
  let summary = "Lowers XLA shared dialect ops to XLA GPU ops.";

  let description = [{
    Lowers XLA shared dialect ops to XLA GPU ops.
  }];

  let dependentDialects = [
    "xla::XlaDialect",
    "mlir::gpu::GPUDialect",
    "mlir::scf::SCFDialect",
  ];
}

def InsertPDLPass : Pass<"xla-gpu-insert-pdl", "mlir::ModuleOp"> {
  let summary = "Inserts programmatic dependent launch (PDL) ops.";
  let description = [{
    Inserts `xla_gpu.pdl_wait` op to guard global memory operations.
  }];
  let dependentDialects = [
    "xla::gpu::XlaGpuDialect",
    "mlir::func::FuncDialect",
    "mlir::scf::SCFDialect",
    "mlir::cf::ControlFlowDialect",
  ];
}

def PromoteShuffleToDPPPass
    : Pass<"xla-gpu-promote-shuffle-to-dpp", "mlir::ModuleOp"> {
  let summary = "Promotes gpu.shuffle down to DPP/swizzle on AMD GPUs.";

  let description = [{
    Replaces gpu.shuffle ops with ShuffleMode::DOWN with faster AMD-specific
    instructions, chosen by offset:

      Offsets 1-15:  amdgpu.dpp row_shr  (register-to-register, ALU-fusible)
      Offset 16:     amdgpu.swizzle_bitmode with XOR semantics (ds_swizzle)
      Offset 32:     left as gpu.shuffle (falls through to ds_bpermute)

    DPP row_shr operates within 16-lane rows. For offset 16, ds_swizzle is
    used instead: it operates within 32-lane groups using bitwise lane-ID
    transforms. The shuffle-down is re-expressed as XOR, which is valid for
    the reduction use case because lane+d == lane^d for all lanes where
    bit log2(d) is zero -- exactly the lanes whose results matter in a
    tree reduction.

    The transformation is applied only when the validity predicate (second
    result of gpu.shuffle) has no users, which is always the case in XLA's
    shuffle-reduce lowering.
  }];

  let dependentDialects = [
    "mlir::gpu::GPUDialect",
    "mlir::arith::ArithDialect",
    "mlir::amdgpu::AMDGPUDialect",
  ];
}

def VirtualizeSubKernelPass
    : Pass<"xla-gpu-virtualize-sub-kernel", "mlir::ModuleOp"> {
  let summary = "Virtualizes a lowered LLVM/NVVM sub-kernel for horizontal fusion.";

  let description = [{
    Transforms a lowered sub-kernel module (in the `llvm` and `nvvm` dialects)
    into a virtualized sub-kernel ready to be spliced into a horizontal fusion
    launcher module:
      1. Strips trailing scratch pointer arguments when the entry function has
         more arguments than `expected_num_tensor_args`.
      2. Appends `%rel_bid_i32 : i32` to the entry function signature.
      3. Replaces `nvvm.read.ptx.sreg.ctaid.{x,y,z}` and `nctaid.{x,y,z}` ops
         using `%rel_bid_i32` (delinearizing for 2D/3D grids).
      4. Replaces `nvvm.read.ptx.sreg.tid.{x,y,z}` and `ntid.{x,y,z}` ops
         (delinearizing from 1D `tid.x` for 2D/3D thread blocks).
      5. Rewrites 0-operand `nvvm.barrier` ops to partial-CTA
         `nvvm.barrier id = 0 number_of_threads = %sub_threads` when the
         sub-kernel uses fewer threads than `max_threads`.
      6. Packs private `addrspace(3)` globals into 16-byte-aligned byte offsets
         of external `@global_smem` and records the sub-kernel's total shared
         memory requirement in `"xla.shared_memory_bytes"` on the module.
  }];

  let dependentDialects = [
    "mlir::LLVM::LLVMDialect",
    "mlir::NVVM::NVVMDialect",
  ];

  let options = [
    Option<"entry_function_name_", "entry_function_name", "std::string",
           /*default=*/"\"\"", "Name of the sub-kernel entry function.">,
    Option<"expected_num_tensor_args_", "expected_num_tensor_args", "int64_t",
           /*default=*/"-1",
           "Expected number of tensor pointer arguments (-1 to keep all).">,
    Option<"block_dim_x_", "block_dim_x", "int64_t", /*default=*/"1",
           "Sub-kernel grid dimension X.">,
    Option<"block_dim_y_", "block_dim_y", "int64_t", /*default=*/"1",
           "Sub-kernel grid dimension Y.">,
    Option<"block_dim_z_", "block_dim_z", "int64_t", /*default=*/"1",
           "Sub-kernel grid dimension Z.">,
    Option<"thread_dim_x_", "thread_dim_x", "int64_t", /*default=*/"1",
           "Sub-kernel thread dimension X.">,
    Option<"thread_dim_y_", "thread_dim_y", "int64_t", /*default=*/"1",
           "Sub-kernel thread dimension Y.">,
    Option<"thread_dim_z_", "thread_dim_z", "int64_t", /*default=*/"1",
           "Sub-kernel thread dimension Z.">,
    Option<"max_threads_", "max_threads", "int64_t", /*default=*/"1",
           "Outer horizontal kernel thread count per block.">,
    Option<"warp_size_", "warp_size", "int64_t", /*default=*/"32",
           "Hardware warp size.">,
  ];
}

#endif  // XLA_SERVICE_GPU_FUSIONS_TRANSFORMS_PASSES_TD_

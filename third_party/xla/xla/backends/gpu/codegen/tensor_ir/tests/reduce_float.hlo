// CHECK: %[[RESULT:.*]] = arith.addf %[[RHS]], %[[LHS]] : f32
// CHECK: yield %[[RESULT]]
// CHECK: %[[OUT:.*]] = reshape %[[REDUCE]] : tensor<16x1xf32> -> tensor<16xf32>
// CHECK: results %[[OUT]]

body_add_flip {
  %lhs = f32[] parameter(0)
  %rhs = f32[] parameter(1)
  ROOT %agg = f32[] add(%rhs, %lhs)
}

test_reduce_add_flip {
  %p0 = f32[16,64] parameter(0)
  %c0 = f32[] constant(0.0)
  ROOT %out = f32[16] reduce(%p0, %c0), dimensions={1}, to_apply=body_add_flip
}


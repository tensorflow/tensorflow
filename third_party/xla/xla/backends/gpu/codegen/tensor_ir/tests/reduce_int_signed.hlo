// CHECK: %[[REDUCE:.*]] = reduce_ud(%[[ARG0]]) <dimensions = [1], identity = [1 : si32]> (%[[LHS:.*]]: i32, %[[RHS:.*]]: i32) {
// CHECK: %[[RESULT:.*]] = arith.muli %[[RHS]], %[[LHS]] : i32
// CHECK: yield %[[RESULT]]

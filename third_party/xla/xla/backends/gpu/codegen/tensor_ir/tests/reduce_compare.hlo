// CHECK-LABEL: @test_compare_int_signed
// CHECK: arith.cmpi eq
// CHECK: arith.cmpi ne
// CHECK: arith.cmpi slt
// CHECK: arith.cmpi sle
// CHECK: arith.cmpi sgt
// CHECK: arith.cmpi sge

compare_signed {
  %lhs = s32[] parameter(0)
  %rhs = s32[] parameter(1)
  %eq = pred[] compare(%lhs, %rhs), direction=EQ
  %ne = pred[] compare(%lhs, %rhs), direction=NE
  %lt = pred[] compare(%lhs, %rhs), direction=LT
  %le = pred[] compare(%lhs, %rhs), direction=LE
  %gt = pred[] compare(%lhs, %rhs), direction=GT
  %ge = pred[] compare(%lhs, %rhs), direction=GE
  %x1 = pred[] xor(%eq, %ne)
  %x2 = pred[] xor(%x1, %lt)
  %x3 = pred[] xor(%x2, %le)
  %x4 = pred[] xor(%x3, %gt)
  %x5 = pred[] xor(%x4, %ge)
  ROOT %res = s32[] select(%x5, %lhs, %rhs)
}

test_compare_int_signed {
  %p0 = s32[16,64] parameter(0)
  %c0 = s32[] constant(0)
  ROOT %out = s32[16] reduce(%p0, %c0), dimensions={1}, to_apply=compare_signed
}


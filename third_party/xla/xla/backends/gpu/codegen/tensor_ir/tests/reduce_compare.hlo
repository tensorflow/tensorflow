// RUN: fusion_to_tensorir --hlo-to-tensorir --split-input-file %s | FileCheck %s

// The tests below only verify the lowering of comparison predicates.
// The computations are meaningless and cannot be verified at runtime.

// CHECK-LABEL: @test_compare_float
// CHECK: arith.cmpf oeq
// CHECK: arith.cmpf une
// CHECK: arith.cmpf olt
// CHECK: arith.cmpf ole
// CHECK: arith.cmpf ogt
// CHECK: arith.cmpf oge

compare_float {
  %lhs = f32[] parameter(0)
  %rhs = f32[] parameter(1)
  %eq = pred[] compare(%lhs, %rhs), direction=EQ
  %ne = pred[] compare(%lhs, %rhs), direction=NE
  %lt = pred[] compare(%lhs, %rhs), direction=LT
  %le = pred[] compare(%lhs, %rhs), direction=LE
  %gt = pred[] compare(%lhs, %rhs), direction=GT
  %ge = pred[] compare(%lhs, %rhs), direction=GE
  %x1 = pred[] xor(%eq, %ne)
  %x2 = pred[] xor(%x1, %lt)
  %x3 = pred[] xor(%x2, %le)
  %x4 = pred[] xor(%x3, %gt)
  %x5 = pred[] xor(%x4, %ge)
  ROOT %res = f32[] select(%x5, %lhs, %rhs)
}

test_compare_float {
  %p0 = f32[16,64] parameter(0)
  %c0 = f32[] constant(0.0)
  ROOT %out = f32[16] reduce(%p0, %c0), dimensions={1}, to_apply=compare_float
}


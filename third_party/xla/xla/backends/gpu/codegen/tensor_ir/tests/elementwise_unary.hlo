// -----

// CHECK-LABEL: @test_expm1
// CHECK-SAME: %[[ARG0:.*]]: tensor<8x16xf32>
// CHECK-DAG: %[[ONE:.*]] = constant dense<1.000000e+00>
// CHECK-DAG: %[[EXP:.*]] = exp %[[ARG0]]
// CHECK: %[[OUT:.*]] = sub %[[EXP]], %[[ONE]]
// CHECK: results %[[OUT]]

test_expm1 {
  %p0 = f32[8,16] parameter(0)
  %out = f32[8,16] exponential-minus-one(%p0)
}


// CHECK-LABEL: @test_log1p
// CHECK-SAME: %[[ARG0:.*]]: tensor<8x16xf32>
// CHECK-DAG: %[[ONE:.*]] = constant dense<1.000000e+00>
// CHECK-DAG: %[[ADD:.*]] = add %[[ARG0]], %[[ONE]]
// CHECK: %[[OUT:.*]] = log %[[ADD]]
// CHECK: results %[[OUT]]

test_log1p {
  %p0 = f32[8,16] parameter(0)
  %out = f32[8,16] log-plus-one(%p0)
}


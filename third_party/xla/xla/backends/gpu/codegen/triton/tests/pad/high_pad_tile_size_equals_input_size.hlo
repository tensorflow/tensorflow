// RUN: fusion_to_triton %s | FileCheck %s
// RUN: triton_test_correctness %s

// Dimension 0 is padded and its tile size is equal to the size of the pad
// input, so all tiles except for the first one are entirely padding and must be
// masked. Dimension 1 is not padded, so it must not be masked even though its
// tile size differs from the size of the pad input.
triton_computation {
  param_0 = f32[4,32]{1,0} parameter(0)
  c1 = f32[] constant(1)
  ROOT pad = f32[64,32]{1,0} pad(param_0, c1), padding=0_60x0_0
}
// CHECK: xtile.extract {{.*}} -> tensor<4x16xf32>
// CHECK-NOT: tt.make_range {end = 16 : i32
// CHECK: tt.make_range {end = 4 : i32, start = 0 : i32} : tensor<4xi32>
// CHECK: tt.expand_dims
// CHECK: tt.broadcast
// CHECK: arith.cmpi slt
// CHECK-NOT: tt.make_range
// CHECK-NOT: arith.andi
// CHECK: arith.select

ENTRY main {
  param_0 = f32[4,32]{1,0} parameter(0)
  ROOT triton_fusion = f32[64,32]{1,0} fusion(param_0), kind=kCustom,
    calls=triton_computation, backend_config={
      "fusion_backend_config":{
        "kind":"__triton_nested_gemm_fusion",
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["4","16"]}],
          "num_warps":"1",
          "num_ctas":"1",
          "num_stages":"1"}}}
}

// RUN: fusion_to_triton %s | FileCheck %s
// RUN: triton_test_correctness %s

fusion {
  p = s64[8]{0} parameter(0)
  ROOT result = s64[8]{0} sign(p)
}
// CHECK-DAG: arith.cmpi slt, %{{.*}}, %{{.*}} : tensor<8xi64>
// CHECK-DAG: arith.cmpi sgt, %{{.*}}, %{{.*}} : tensor<8xi64>

ENTRY main {
  // Special values: INT_MIN, -42, -2, -1, 0, 1, 2, INT_MAX.
  input = s64[8]{0} constant({
    -9223372036854775808, -42, -2, -1, 0, 1, 2, 9223372036854775807})
  ROOT fusion = s64[8]{0} fusion(input), kind=kCustom, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["8"]}],
          "num_warps":"1",
          "num_ctas":"1",
          "num_stages":"1",
          "is_tma_allowed":false}}}
}

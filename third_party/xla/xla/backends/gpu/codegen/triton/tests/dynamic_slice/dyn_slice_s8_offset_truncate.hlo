// RUN: fusion_to_triton %s | FileCheck %s
// RUN: triton_test_correctness %s

// Test that we extend type of dynamic offset to avoid truncation if the offset
// upper bound overflows the type max value. In this example, clamp is
// 299 = 43 | 256.
// Using s8 for offset calculations will truncate the value and lead to
// incorrect results when min_si(max_si(off, 0), clamp) will return clamp
// instead of offset: min(100, 43) = 43.

fusion {
  p0 = f32[300,16] parameter(0)
  p1 = s8[] parameter(1)
  always_true = pred[] compare(p1, p1), direction=EQ
  // Force runtime offset value > 43 so that min_si(max_si(off, 0), 43)
  // will pick 43 ( = (300 - 1) % 256) instead of offset for s8 calculation.
  c100 = s8[] constant(100)
  c0 = s8[] constant(0)
  offset = s8[] select(always_true, c100, c0)
  ROOT ds = f32[1,16] dynamic-slice(p0, offset, c0), dynamic_slice_sizes={1,16}
}
// CHECK-LABEL: xtile.entry_func @triton_fn(
// CHECK-DAG:     %[[C100:.*]] = arith.constant 100 : index
// CHECK:         xtile.extract %{{.*}}[%[[C100]], %{{.*}}] [1, 16] [1, 1] : memref<300x16xf32> -> tensor<1x16xf32>

ENTRY main {
  p0 = f32[300,16] parameter(0)
  p1 = s8[] parameter(1)
  ROOT fusion = f32[1,16] fusion(p0, p1), kind=kCustom, calls=fusion,
    backend_config={"fusion_backend_config":{"kind":"__triton",
      "block_level_fusion_config":{
      "output_tiles":[{"sizes":["1","16"]}],
        "num_warps":1,"num_ctas":1,"num_stages":1}}}
}

// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation=false %s 2>&1 | FileCheck %s
// RUN: triton_test_correctness --xla_gpu_experimental_enable_tiling_propagation=false %s

// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation %s 2>&1 | FileCheck %s --check-prefixes=CHECK-TILING
// RUN: triton_test_correctness --xla_gpu_experimental_enable_tiling_propagation %s

// This is a fork of concat_prune_inactive.hlo that uses a smaller concat-dim
// tile size (16 instead of 64). With the sign-agnostic boundary-alignment
// check (b/491092362), a negative base offset is legal as long as every operand
// boundary lands on a tile boundary (i.e. its distance from the base offset is
// a multiple of the tile size). Here the relevant operand boundaries along the
// concat dim land at rows 16, 32 and 64, all multiples of 16, so no tile
// straddles an operand boundary and the tiling is accepted. Unlike the
// tile-size-64 variant (which is correctly rejected), tiling propagation
// succeeds here and the fusion is emitted, so we also exercise the on-device
// correctness check with tiling propagation enabled.

// CHECK:      xtile.entry_func @triton_fn

// CHECK-TILING:      xtile.entry_func @triton_fn

HloModule min_repro, is_scheduled=true, entry_computation_layout={(f32[64,10]{1,0}, f32[1,16,10]{2,1,0}, f32[1,16,10]{2,1,0})->f32[64,10]{1,0}}

%fused_computation (param_0: f32[64,10], param_1: f32[1,16,10], param_2: f32[1,16,10]) -> f32[64,10] {
  %param_0 = f32[64,10]{1,0} parameter(0)
  %param_1 = f32[1,16,10]{2,1,0} parameter(1)
  %param_2 = f32[1,16,10]{2,1,0} parameter(2)
  %inner_concat = f32[1,32,10]{2,1,0} concatenate(%param_1, %param_2), dimensions={1}
  %reshape = f32[32,10]{1,0} reshape(%inner_concat)
  %concat = f32[96,10]{1,0} concatenate(%param_0, %reshape), dimensions={0}
  ROOT %slice = f32[64,10]{1,0} slice(%concat), slice={[0:64], [0:10]}
}

ENTRY %entry_computation (param_0: f32[64,10], param_1: f32[1,16,10], param_2: f32[1,16,10]) -> f32[64,10] {
  %param_0 = f32[64,10]{1,0} parameter(0)
  %param_1 = f32[1,16,10]{2,1,0} parameter(1)
  %param_2 = f32[1,16,10]{2,1,0} parameter(2)
  ROOT %fusion = f32[64,10]{1,0} fusion(%param_0, %param_1, %param_2), kind=kCustom, calls=%fused_computation,
    backend_config={
      "operation_queue_id":"0",
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "num_warps":"4",
          "output_tiles":[{"sizes":["16","10"]}],
          "num_ctas":1,
          "num_stages":1,
          "is_tma_allowed":true,
          "is_warp_specialization_allowed":false,
          "waves_per_eu":0
        }
      },
      "force_earliest_schedule":false,
      "reification_cost":[],
      "device_type":"DEVICE_TYPE_INVALID"
    }
}

// RUN: fusion_to_triton %s | FileCheck %s
// RUN: triton_test_correctness %s

fusion {
  p0 = s32[64] parameter(0)
  slice1 = s32[1] slice(p0), slice={[0:1]}
  off = s32[] reshape(slice1)
  d1 = s32[20] dynamic-slice(p0, off), dynamic_slice_sizes={20}
  slice2 = s32[1] slice(d1), slice={[1:2]}
  off2 = s32[] reshape(slice2)
  ROOT d2 = s32[10] dynamic-slice(d1, off2), dynamic_slice_sizes={10}
}
// CHECK-DAG: #[[MAP:.*]] = #xla.indexing_map<"(d0{{.*}}) -> (d0{{.*}} + 1), domain: d0{{.*}} in [0, 44]">
// CHECK-DAG: #[[MAP1:.*]] = #xla.indexing_map<"(d0{{.*}}, d1{{.*}}) -> (d0{{.*}} + d1{{.*}}), domain: d0{{.*}} in [0, 10], d1{{.*}} in [0, 44]">
// CHECK: xtile.entry_func @triton_fn(
// CHECK-SAME:    %[[ARG0:.*]]: memref<64xi32>,
// CHECK-SAME:    %[[ARG1:.*]]: memref<10xi32>,
// CHECK-SAME:    %[[ARG2:.*]]: index{{( \{xla.range = \[0 : index, 0 : index\]\})?}})
// CHECK-DAG:     %[[C10:.*]] = arith.constant 10 : i32
// CHECK-DAG:     %[[C44:.*]] = arith.constant 44 : i32
// CHECK-DAG:     %[[C0_I32:.*]] = arith.constant 0 : i32
// CHECK-DAG:     %[[C0:.*]] = arith.constant 0 : index
// CHECK:         %[[EXTRACT0:.*]] = xtile.extract %[[ARG0]][%[[C0]]] [1] [{{.*}}] : memref<64xi32> -> tensor<1xi32>
// CHECK:         %[[UNSPLAT0:.*]] = tt.unsplat %[[EXTRACT0]] : tensor<1xi32>
// CHECK:         %[[MAX0:.*]] = arith.maxsi %[[UNSPLAT0]], %[[C0_I32]] : i32
// CHECK:         %[[MIN0:.*]] = arith.minsi %[[MAX0]], %[[C44]] : i32
// CHECK:         %[[CAST0:.*]] = arith.index_cast %[[MIN0]] : i32 to index
// CHECK:         %[[IDX0:.*]] = xla.apply_indexing #[[MAP]](%[[CAST0]])
// CHECK:         %[[EXTRACT1:.*]] = xtile.extract %[[ARG0]][%[[IDX0]]] [1] [{{.*}}] : memref<64xi32> -> tensor<1xi32>
// CHECK:         %[[UNSPLAT1:.*]] = tt.unsplat %[[EXTRACT1]] : tensor<1xi32>
// CHECK:         %[[MAX1:.*]] = arith.maxsi %[[UNSPLAT1]], %[[C0_I32]] : i32
// CHECK:         %[[MIN1:.*]] = arith.minsi %[[MAX1]], %[[C10]] : i32
// CHECK:         %[[CAST1:.*]] = arith.index_cast %[[MIN1]] : i32 to index
// CHECK:         %[[IDX1:.*]] = xla.apply_indexing #[[MAP1]](%[[CAST1]], %[[CAST0]])
// CHECK:         %[[EXTRACT2:.*]] = xtile.extract %[[ARG0]][%[[IDX1]]] [32] [{{.*}}] : memref<64xi32> -> tensor<32xi32>
// CHECK:         xtile.insert %[[EXTRACT2]] into %[[ARG1]][%[[C0]]] [32] [{{.*}}] : tensor<32xi32> -> memref<10xi32>
// CHECK:         xtile.return

ENTRY main {
  p0 = s32[64] parameter(0)
  ROOT fusion = s32[10] fusion(p0), kind=kCustom, calls=fusion,
    backend_config={"fusion_backend_config":{"kind":"__triton",
      "block_level_fusion_config":{
      "output_tiles":[{"sizes":["32"]}],
        "num_warps":1,"num_ctas":1,"num_stages":1}}}
}

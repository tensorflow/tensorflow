// RUN: fusion_to_triton %s 2>&1 | FileCheck %s --check-prefixes=CHECK-ERROR

// Expected IR once b/528277610 is fixed:
// CHECK:      xtile.entry_func @triton_fn
// CHECK-NEXT:   %[[C0:.*]] = arith.constant 0 : index
// CHECK-NEXT:   %[[EXTRACT:.*]] = xtile.extract %arg0[%[[C0]], %[[C0]]] [64, 16] [1, 1] : memref<64x10xf32> -> tensor<64x16xf32>
// CHECK-NEXT:   xtile.insert %[[EXTRACT]] into %arg3[%[[C0]], %[[C0]]] [64, 16] [1, 1] : tensor<64x16xf32> -> memref<64x10xf32>
// CHECK-NEXT:   xtile.return

// The nested concatenate produces a concat-dim tile offset with a negative
// constant part (base offset -64). Under this fusion's concat-dim tile size
// (64), the remaining size 80 (the distance from the base offset to the end of
// operand 0) is not a multiple of 64 (80 mod 64 = 16), so a tile would straddle
// an operand boundary and the tiling is correctly rejected. This is the
// sign-agnostic boundary-alignment check from b/491092362 (the old check
// rejected purely on the negative sign with a different message).
// TODO: b/528277610 - fix tiling emitter.
// CHECK-ERROR: Tiling propagation rejected for %inner_concat = f32[1,32,10]{2,1,0} concatenate(%param_1, %param_2), dimensions={1}: The remaining operand size 16 (in concatenate operand 0) is not divisible by the selected tile size 64

HloModule min_repro, is_scheduled=true, entry_computation_layout={(f32[64,10]{1,0}, f32[1,16,10]{2,1,0}, f32[1,16,10]{2,1,0})->f32[64,10]{1,0}}

%fused_computation (param_0: f32[64,10], param_1: f32[1,16,10], param_2: f32[1,16,10]) -> f32[64,10] {
  %param_0 = f32[64,10]{1,0} parameter(0)
  %param_1 = f32[1,16,10]{2,1,0} parameter(1)
  %param_2 = f32[1,16,10]{2,1,0} parameter(2)
  %inner_concat = f32[1,32,10]{2,1,0} concatenate(%param_1, %param_2), dimensions={1}
  %reshape = f32[32,10]{1,0} reshape(%inner_concat)
  %concat = f32[96,10]{1,0} concatenate(%param_0, %reshape), dimensions={0}
  ROOT %slice = f32[64,10]{1,0} slice(%concat), slice={[0:64], [0:10]}
}

ENTRY %entry_computation (param_0: f32[64,10], param_1: f32[1,16,10], param_2: f32[1,16,10]) -> f32[64,10] {
  %param_0 = f32[64,10]{1,0} parameter(0)
  %param_1 = f32[1,16,10]{2,1,0} parameter(1)
  %param_2 = f32[1,16,10]{2,1,0} parameter(2)
  ROOT %fusion = f32[64,10]{1,0} fusion(%param_0, %param_1, %param_2), kind=kCustom, calls=%fused_computation,
    backend_config={
      "operation_queue_id":"0",
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "num_warps":"4",
          "output_tiles":[{"sizes":["64","10"]}],
          "num_ctas":1,
          "num_stages":1,
          "is_tma_allowed":true,
          "is_warp_specialization_allowed":false,
          "waves_per_eu":0
        }
      },
      "force_earliest_schedule":false,
      "reification_cost":[],
      "device_type":"DEVICE_TYPE_INVALID"
    }
}

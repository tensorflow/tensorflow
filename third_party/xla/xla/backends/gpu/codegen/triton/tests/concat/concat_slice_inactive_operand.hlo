// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation %s 2>&1 | FileCheck %s
// RUN: triton_test_correctness --xla_gpu_experimental_enable_tiling_propagation %s

// The slice effectively accesses only second parameter so we can skip scf.if .

// CHECK:      xtile.entry_func @triton_fn
// CHECK-NOT:    scf.if
// CHECK:        %[[C0:.*]] = arith.constant 0 : index
// CHECK-NEXT:   %[[EXTRACT:.*]] = xtile.extract %arg1[%[[C0]], %[[C0]]] [32, 16] [1, 1] : memref<32x16xf32> -> tensor<32x16xf32>
// CHECK-NEXT:   xtile.insert %[[EXTRACT]] into %arg2[%[[C0]], %[[C0]]] [32, 16] [1, 1]
// CHECK-NEXT:   xtile.return

HloModule concat_slice_second_operand, is_scheduled=true, entry_computation_layout={(f32[64,16]{1,0}, f32[32,16]{1,0})->f32[32,16]{1,0}}

%fused_computation (param_0: f32[64,16], param_1: f32[32,16]) -> f32[32,16] {
  %param_0 = f32[64,16]{1,0} parameter(0)
  %param_1 = f32[32,16]{1,0} parameter(1)
  %concat = f32[96,16]{1,0} concatenate(%param_0, %param_1), dimensions={0}
  ROOT %slice = f32[32,16]{1,0} slice(%concat), slice={[64:96], [0:16]}
}

ENTRY %entry_computation (param_0: f32[64,16], param_1: f32[32,16]) -> f32[32,16] {
  %param_0 = f32[64,16]{1,0} parameter(0)
  %param_1 = f32[32,16]{1,0} parameter(1)
  ROOT %fusion = f32[32,16]{1,0} fusion(%param_0, %param_1), kind=kCustom, calls=%fused_computation,
    backend_config={
      "operation_queue_id":"0",
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "num_warps":"4",
          "output_tiles":[{"sizes":["32","16"]}],
          "num_ctas":1,
          "num_stages":1,
          "is_tma_allowed":true,
          "is_warp_specialization_allowed":false,
          "waves_per_eu":0
        }
      },
      "force_earliest_schedule":false,
      "reification_cost":[],
      "device_type":"DEVICE_TYPE_INVALID"
    }
}

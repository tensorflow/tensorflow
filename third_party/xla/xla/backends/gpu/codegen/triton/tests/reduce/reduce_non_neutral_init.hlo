// RUN: fusion_to_triton %s | FileCheck %s
// RUN: triton_test_correctness %s

region {
  p0 = f32[] parameter(0)
  p1 = f32[] parameter(1)
  ROOT max = f32[] maximum(p0, p1)
}

fusion {
  p = f32[8,16] parameter(0)
  c = f32[] constant(5.0)
  ROOT reduce = f32[8] reduce(p, c), dimensions={1}, to_apply=region,
    backend_config={sizes:[4]}
}

// CHECK-DAG: %[[INIT_VAL:.*]] = arith.constant dense<5.000000e+00> : tensor<4xf32>
// CHECK: %[[FOR:.*]] = scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}}
// CHECK: %[[REDUCE:.*]] = "tt.reduce"(%[[FOR]]) <{axis = 1 : i32}>
// CHECK: %[[COMBINED:.*]] = arith.maximumf %[[REDUCE]], %[[INIT_VAL]] : tensor<4xf32>

ENTRY main {
  p = f32[8,16] parameter(0)
  ROOT fusion = f32[8] fusion(p), kind=kCustom,
    calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["4"]}],
          "num_warps":"1",
          "num_ctas":"1",
          "num_stages":"1"}}}
}

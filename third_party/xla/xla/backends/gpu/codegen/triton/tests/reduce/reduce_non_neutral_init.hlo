// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation=false %s | FileCheck %s --check-prefix=CHECK-UNTILED
// RUN: triton_test_correctness --xla_gpu_experimental_enable_tiling_propagation=false %s
// RUN: fusion_to_triton --xla_gpu_experimental_enable_tiling_propagation %s | FileCheck %s --check-prefixes=CHECK-TILED
// RUN: triton_test_correctness %s --xla_gpu_experimental_enable_tiling_propagation

region {
  p0 = f32[] parameter(0)
  p1 = f32[] parameter(1)
  ROOT max = f32[] maximum(p0, p1)
}

fusion {
  p = f32[8,16] parameter(0)
  c = f32[] constant(5.0)
  ROOT reduce = f32[8] reduce(p, c), dimensions={1}, to_apply=region,
    backend_config={sizes:[4]}
}

// CHECK-UNTILED: %[[INIT:.*]] = arith.constant dense<5.000000e+00> : tensor<4xf32>
// CHECK-UNTILED: %[[REDUCE_INPUT:.*]] = xtile.extract %{{.*}} :
// CHECK-UNTILED: %[[REDUCE:.*]] = "tt.reduce"(%[[REDUCE_INPUT]]) <{axis = 1 : i32}>
// CHECK-UNTILED: %[[COMBINED:.*]] = arith.maximumf %[[REDUCE]], %[[INIT]] : tensor<4xf32>

// CHECK-TILED-DAG: %[[INIT_VAL:.*]] = arith.constant dense<5.000000e+00> : tensor<4xf32>
// CHECK-TILED: %[[FOR:.*]] = scf.for %{{.*}} = %{{.*}} to %{{.*}} step %{{.*}}
// CHECK-TILED: %[[REDUCE:.*]] = "tt.reduce"(%[[FOR]]) <{axis = 1 : i32}>
// CHECK-TILED: %[[COMBINED:.*]] = arith.maximumf %[[REDUCE]], %[[INIT_VAL]] : tensor<4xf32>

ENTRY main {
  p = f32[8,16] parameter(0)
  ROOT fusion = f32[8] fusion(p), kind=kCustom,
    calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["4"]}],
          "num_warps":"1",
          "num_ctas":"1",
          "num_stages":"1"}}}
}

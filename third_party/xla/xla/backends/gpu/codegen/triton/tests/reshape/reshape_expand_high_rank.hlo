// RUN: fusion_to_triton %s --xla_gpu_experimental_enable_tiling_propagation | FileCheck %s
// RUN: triton_test_correctness --xla_gpu_experimental_enable_tiling_propagation %s

fusion {
  p = f32[512,16] parameter(0)
  ROOT reshape = f32[1,1,8,64,16] reshape(p)
}

// CHECK-LABEL:  xtile.entry_func @triton_fn(
// CHECK-SAME:     %[[ARG0:.*]]: memref<512x16xf32>,
// CHECK-SAME:     %[[ARG1:.*]]: memref<1x1x8x64x16xf32>,
// CHECK-SAME:     %[[ARG2:.*]]: index)
// CHECK:          %[[C0:.*]] = arith.constant 0 : index
// CHECK:          %[[EXTRACT:.*]] = xtile.extract %[[ARG0]][%[[C0]], %[[C0]]] [512, 16] [1, 1] : memref<512x16xf32> -> tensor<512x16xf32>
// CHECK:          %[[RESHAPE:.*]] = tt.reshape %[[EXTRACT]] : tensor<512x16xf32> -> tensor<8x64x16xf32>
// CHECK:          %[[EXPAND0:.*]] = tt.expand_dims %[[RESHAPE]] {axis = 0 : i32} : tensor<8x64x16xf32> -> tensor<1x8x64x16xf32>
// CHECK:          %[[EXPAND1:.*]] = tt.expand_dims %[[EXPAND0]] {axis = 0 : i32} : tensor<1x8x64x16xf32> -> tensor<1x1x8x64x16xf32>
// CHECK:          %[[BROADCAST:.*]] = tt.broadcast %[[EXPAND1]] : tensor<1x1x8x64x16xf32> -> tensor<1x2x8x64x16xf32>
// CHECK:          xtile.insert %[[BROADCAST]] into %[[ARG1]][%[[C0]], %[[C0]], %[[C0]], %[[C0]], %[[C0]]] [1, 2, 8, 64, 16] [1, 1, 1, 1, 1] : tensor<1x2x8x64x16xf32> -> memref<1x1x8x64x16xf32>
// CHECK:          xtile.return

ENTRY main {
  p = f32[512,16] parameter(0)
  ROOT fusion = f32[1,1,8,64,16] fusion(p), kind=kCustom, calls=fusion,
    backend_config={
    "fusion_backend_config":{
      "kind":"__triton",
      "block_level_fusion_config":{
        "output_tiles":[{"sizes":[1,2,8,64,16]}],
        "num_warps":"1",
        "num_ctas":"1",
        "num_stages":"1"}}}
}

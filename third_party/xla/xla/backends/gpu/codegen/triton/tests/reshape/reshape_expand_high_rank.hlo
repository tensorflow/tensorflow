// RUN: fusion_to_triton %s --xla_gpu_experimental_enable_tiling_propagation 2>&1 | FileCheck %s --check-prefixes=CHECK-ERROR

// CHECK-ERROR: INVALID_ARGUMENT: Reshape input and output shapes must be the same, got 512x16 -> 1x2x8x64x16

fusion {
  p = f32[512,16] parameter(0)
  ROOT reshape = f32[1,1,8,64,16] reshape(p)
}

ENTRY main {
  p = f32[512,16] parameter(0)
  ROOT fusion = f32[1,1,8,64,16] fusion(p), kind=kCustom, calls=fusion,
    backend_config={
    "fusion_backend_config":{
      "kind":"__triton",
      "block_level_fusion_config":{
        "output_tiles":[{"sizes":[1,2,8,64,16]}],
        "num_warps":"1",
        "num_ctas":"1",
        "num_stages":"1"}}}
}

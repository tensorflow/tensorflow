// RUN: fusion_to_triton %s | FileCheck %s
// RUN: triton_test_correctness %s

fusion {
  p = f16[16]{0} parameter(0)
  s = f16[16]{0} sign(p)
  // Map -0.0 -> -inf and +0.0 -> +inf so float equality distinguishes the
  // preserved sign bit of zero.
  one = f16[] constant(1.0)
  ones = f16[16]{0} broadcast(one), dimensions={}
  inv = f16[16]{0} divide(ones, s)
  ROOT result = f16[32]{0} concatenate(s, inv), dimensions={0}
}
// CHECK-DAG: arith.cmpf olt, %{{.*}}, %{{.*}} : tensor<16xf16>
// CHECK-DAG: arith.cmpf ogt, %{{.*}}, %{{.*}} : tensor<16xf16>

ENTRY main {
  // Special values: -inf, -max, -1, -min, -denorm_min, -0, 0, denorm_min,
  // min, 1, max, +inf, nan, -nan, 42, -42.
  input = f16[16]{0} constant({
    -inf, -65504.0, -1.0, -6.103515625e-5, -5.9604644775390625e-8, -0.0,
    0.0, 5.9604644775390625e-8, 6.103515625e-5, 1.0, 65504.0, inf,
    nan, -nan, 42.0, -42.0})
  ROOT fusion = f16[32]{0} fusion(input), kind=kCustom, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16"]}],
          "num_warps":"1",
          "num_ctas":"1",
          "num_stages":"1",
          "is_tma_allowed":false}}}
}

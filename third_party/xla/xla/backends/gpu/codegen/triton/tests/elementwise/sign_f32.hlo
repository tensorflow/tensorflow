// RUN: fusion_to_triton %s | FileCheck %s
// RUN: triton_test_correctness %s

fusion {
  p = f32[16]{0} parameter(0)
  s = f32[16]{0} sign(p)
  // Map -0.0 -> -inf and +0.0 -> +inf so float equality distinguishes the
  // preserved sign bit of zero.
  one = f32[] constant(1.0)
  ones = f32[16]{0} broadcast(one), dimensions={}
  inv = f32[16]{0} divide(ones, s)
  ROOT result = f32[32]{0} concatenate(s, inv), dimensions={0}
}
// CHECK-DAG: arith.cmpf olt, %{{.*}}, %{{.*}} : tensor<16xf32>
// CHECK-DAG: arith.cmpf ogt, %{{.*}}, %{{.*}} : tensor<16xf32>

ENTRY main {
  // Special values: -inf, -max, -1, -min, -denorm_min, -0, 0, denorm_min,
  // min, 1, max, +inf, nan, -nan, 42, -42.
  input = f32[16]{0} constant({
    -inf, -3.40282347e+38, -1.0, -1.17549435e-38, -1.40129846e-45, -0.0,
    0.0, 1.40129846e-45, 1.17549435e-38, 1.0, 3.40282347e+38, inf,
    nan, -nan, 42.0, -42.0})
  ROOT fusion = f32[32]{0} fusion(input), kind=kCustom, calls=fusion,
    backend_config={
      "fusion_backend_config":{
        "kind":"__triton",
        "block_level_fusion_config":{
          "output_tiles":[{"sizes":["16"]}],
          "num_warps":"1",
          "num_ctas":"1",
          "num_stages":"1",
          "is_tma_allowed":false}}}
}

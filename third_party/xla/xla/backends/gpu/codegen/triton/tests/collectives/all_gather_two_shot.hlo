// RUN: fusion_to_triton %s | FileCheck %s
f {
  %param0 = f32[64,128]{1,0} parameter(0)
  ROOT result = f32[64,256]{1,0} all-gather(%param0),
    replica_groups={{0,1}}, dimensions={1},
    backend_config={
      "collective_backend_config": {
        "kernel_strategy": "KERNEL_STRATEGY_TRITON_TWO_SHOT"
      }
    }
}

ENTRY entry {
  p0 = f32[64,128]{1,0} parameter(0)
  ROOT %fusion = f32[64,256]{1,0} fusion(p0),
    kind=kCustom, calls=f,
    backend_config={
      "fusion_backend_config": {
        "kind": "__triton_collective",
        "block_level_fusion_config": {
          "num_warps": "4",
          "output_tiles": [{sizes: [16,16]}],
          "num_ctas": 1,
          "num_stages": 1,
          "is_tma_allowed": false,
          "is_warp_specialization_allowed": false
        }
      }
    }
}

// Two-shot push-based AllGather writes each rank's local tile directly into
// peer `pid / 32`'s symmetric output buffer at shard `rank`
// (`(pid mod 8) * 16 + rank * 128`) between pairwise barriers.

// CHECK-DAG:   #[[$INTRA_MAP:.*]] = #xla.indexing_map<"(pid) -> ((pid mod 8) * 16), domain: pid in [0, 63]">
// CHECK-DAG:   #[[$PEER_MAP:.*]] = #xla.indexing_map<"(pid) -> (pid / 32), domain: pid in [0, 63]">
// CHECK-LABEL: xtile.entry_func @triton_fn(
// CHECK-SAME:    %[[INPUT:[^:]+]]: memref<64x128xf32>,
// CHECK-SAME:    %[[OUTPUT:[^:]+]]: memref<2xi64>,
// CHECK-SAME:    %[[SIGNAL_BUFFERS:[^:]+]]: memref<2xi64>,
// CHECK-SAME:    %[[RANK_IDX:[^:]+]]: index {xla.range = [0 : index, 1 : index]},
// CHECK-SAME:    %[[TILE_ID:[^:]+]]: index {xla.range = [0 : index, 63 : index]})
// CHECK-SAME:    attributes {has_rank, has_signal_buffer}
// CHECK-DAG:   %[[C128:.*]] = arith.constant 128 : index
// CHECK-DAG:   %[[INTRA_OFFSET:.*]] = xla.apply_indexing #[[$INTRA_MAP]](%[[TILE_ID]])
// CHECK:       %[[LOCAL_TILE:.*]] = xtile.extract %[[INPUT]][%[[ROW_OFFSET:[^,]+]], %[[INTRA_OFFSET]]]
// CHECK:       %[[RANK:.*]] = arith.index_cast %[[RANK_IDX]] : index to i32
// CHECK:       %[[PID:.*]] = tt.get_program_id x
// CHECK:       %[[SLICE:.*]] = arith.divui %[[PID]], %{{.*}}
// CHECK:       %[[PEER:.*]] = arith.remui %[[SLICE]], %{{.*}}
// CHECK:       %[[SIGNAL_PTR:.*]] = triton_xla.memref_to_ptr %[[SIGNAL_BUFFERS]]
// CHECK-NOT:   ttg.barrier local
// CHECK:       triton_xla.block_barrier %[[SIGNAL_PTR]], %[[RANK]], %{{.*}}, %[[PEER]]
// CHECK-SAME:    <world_size = 2, signal_stride = 32, barrier_mode = pairwise_symmetric>
// CHECK:       %[[PEER_IDX:.*]] = xla.apply_indexing #[[$PEER_MAP]](%[[TILE_ID]])
// CHECK:       %[[PEER_BUF:.*]] = xtile.select_buffer %[[OUTPUT]][%[[PEER_IDX]]] : memref<2xi64> -> memref<64x256xf32>
// CHECK:       %[[SHARD_BASE:.*]] = arith.muli %[[RANK_IDX]], %[[C128]] : index
// CHECK:       %[[DST_COL_OFFSET:.*]] = arith.addi %[[INTRA_OFFSET]], %[[SHARD_BASE]] : index
// CHECK:       xtile.insert %[[LOCAL_TILE]] into %[[PEER_BUF]][%[[ROW_OFFSET]], %[[DST_COL_OFFSET]]]
// CHECK:       ttg.barrier local
// CHECK:       triton_xla.block_barrier %[[SIGNAL_PTR]], %[[RANK]], %{{.*}}, %[[PEER]]
// CHECK-SAME:    <world_size = 2, signal_stride = 32, barrier_mode = pairwise_symmetric>
// CHECK:       xtile.return

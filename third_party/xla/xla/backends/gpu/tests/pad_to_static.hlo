// RUN: hlo-opt %s --platform=gpu --stage=llvm-before-optimizations --xla_gpu_target_config_filename=%S/../target_config/specs/%{GPU}.txtpb --split-input-file | FileCheck --check-prefixes=CHECK,CHECK-%{PTX} %s
// RUN: hlo-opt %s --platform=gpu --stage=llvm-before-optimizations --xla_gpu_target_config_filename=%S/../target_config/specs/%{GPU}.txtpb --split-input-file | FileCheck --check-prefix=NOINV %s
// RUN: %if !IS_ROCM %{ hlo-opt %s --platform=gpu --stage=ptx --xla_gpu_target_config_filename=%S/../target_config/specs/%{GPU}.txtpb --split-input-file | FileCheck --check-prefix=PTX %s %}

// Loads are not invariant over the whole program.
// NOINV-NOT: !invariant.load

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL: @custom_call_2(
// CHECK-SAME:    ptr noalias readonly align 16 dereferenceable(44) %[[SRC:.*]], ptr noalias align 256 dereferenceable(32) %[[OUT:.*]], ptr noalias align 256 dereferenceable(4) %{{.*}}, ptr noalias align 256 dereferenceable(4) %{{.*}}, ptr noalias align 256 dereferenceable(4) %{{.*}})
// CHECK:         %[[SRC_INT:.*]] = ptrtoint ptr %[[SRC]] to i64
// CHECK:         %[[OFF0:.*]] = add i64 %[[SRC_INT]], 32
// CHECK:         %[[PTR0:.*]] = inttoptr i64 %[[OFF0]] to ptr
// CHECK:         %[[DIM0:.*]] = load i32, ptr %[[PTR0]], align 4
// CHECK:         %[[OFF1:.*]] = add i64 %[[SRC_INT]], 36
// CHECK:         %[[PTR1:.*]] = inttoptr i64 %[[OFF1]] to ptr
// CHECK:         %[[DIM1:.*]] = load i32, ptr %[[PTR1]], align 4
// CHECK:         %[[OFF2:.*]] = add i64 %[[SRC_INT]], 40
// CHECK:         %[[PTR2:.*]] = inttoptr i64 %[[OFF2]] to ptr
// CHECK:         %[[DIM2:.*]] = load i32, ptr %[[PTR2]], align 4
// CHECK-PTX:     %[[TID:.*]] = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
// CHECK-GCN:     %[[TID:.*]] = call i32 @llvm.amdgcn.workitem.id.x()
// CHECK-PTX:     %[[BID:.*]] = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
// CHECK-GCN:     %[[BID:.*]] = call i32 @llvm.amdgcn.workgroup.id.x()
// CHECK:         %[[IS_T0:.*]] = icmp eq i32 %[[TID]], 0
// CHECK:         br i1 %[[IS_T0]], label %[[T0_BB:.*]], label %[[AFTER_T0_BB:.*]]
// CHECK:       [[T0_BB]]:
// CHECK:         store i32 %[[DIM0]], ptr %{{.*}}, align 4
// CHECK:         store i32 %[[DIM1]], ptr %{{.*}}, align 4
// CHECK:         store i32 %[[DIM2]], ptr %{{.*}}, align 4
// CHECK:         br label %[[AFTER_T0_BB]]
// CHECK:       [[AFTER_T0_BB]]:
// CHECK:         %[[MUL01:.*]] = mul i32 %[[DIM0]], %[[DIM1]]
// CHECK:         %[[TOTAL:.*]] = mul i32 %[[MUL01]], %[[DIM2]]
// CHECK:         %[[BID_OFF:.*]] = mul i32 %[[BID]], 8
// CHECK:         %[[LIN:.*]] = add i32 %[[BID_OFF]], %[[TID]]
// CHECK:         %[[IN_DYN:.*]] = icmp ult i32 %[[LIN]], %[[TOTAL]]
// CHECK:         br i1 %[[IN_DYN]], label %[[COPY_BB:.*]], label %[[EXIT_BB:.*]]
// CHECK:       [[COPY_BB]]:
// CHECK:         %[[D2:.*]] = urem i32 %[[LIN]], %[[DIM2]]
// CHECK:         %[[Q1:.*]] = udiv i32 %[[LIN]], %[[DIM2]]
// CHECK:         %[[D1:.*]] = urem i32 %[[Q1]], %[[DIM1]]
// CHECK:         %[[D0:.*]] = udiv i32 %[[Q1]], %[[DIM1]]
// CHECK:         %[[SRC_PTR:.*]] = getelementptr inbounds [8 x i32], ptr %[[SRC]], i32 0, i32 %[[LIN]]
// CHECK:         %[[VAL:.*]] = load i32, ptr %[[SRC_PTR]], align 4
// CHECK:         %[[OUT_D0_MUL:.*]] = mul i32 %[[D0]], 4
// CHECK:         %[[OUT_D1_MUL:.*]] = mul i32 %[[D1]], 2
// CHECK:         %[[OUT_OFF0:.*]] = add i32 %[[OUT_D0_MUL]], %[[OUT_D1_MUL]]
// CHECK:         %[[OUT_OFF:.*]] = add i32 %[[OUT_OFF0]], %[[D2]]
// CHECK:         %[[OUT_PTR:.*]] = getelementptr inbounds [8 x i32], ptr %[[OUT]], i32 0, i32 %[[OUT_OFF]]
// CHECK:         store i32 %[[VAL]], ptr %[[OUT_PTR]], align 4
// CHECK:         br label %[[EXIT_BB]]
// CHECK:       [[EXIT_BB]]:
// CHECK:         ret void

HloModule PadToStatic, is_scheduled=true

ENTRY main {
  %param = s32[2,<=2,2] parameter(0)
  ROOT %custom_call_2 = (s32[2,2,2], s32[], s32[], s32[])
             custom-call(s32[2,<=2,2] %param),
             custom_call_target="PadToStatic"
}

// -----

// Regression test for https://github.com/openxla/xla/pull/47509.
// For f16 with 5 elements (10 bytes), raw_data_size % 4 = 2, so the int32
// dynamic dimension metadata load at offset 10 must use align 1.

// CHECK-LABEL: @pad_to_static(
// CHECK-SAME:    ptr noalias readonly align 16 dereferenceable(14) %[[SRC:.*]], ptr noalias align 256 dereferenceable(10) %{{.*}}, ptr noalias align 256 dereferenceable(4) %{{.*}})
// PTX-LABEL:     .visible .entry pad_to_static(
// PTX:           ld.b16
// PTX:           ld.b16
// PTX:           ld.global.nc.b16
// CHECK:         %[[SRC_INT:.*]] = ptrtoint ptr %[[SRC]] to i64
// CHECK:         %[[META_OFF:.*]] = add i64 %[[SRC_INT]], 10
// CHECK:         %[[META_PTR:.*]] = inttoptr i64 %[[META_OFF]] to ptr
// CHECK:         %[[DIM0:.*]] = load i32, ptr %[[META_PTR]], align 1
// CHECK:         store i32 %[[DIM0]], ptr %{{.*}}, align 4
// CHECK:         load half, ptr %{{.*}}, align 2
// CHECK:         store half %{{.*}}, ptr %{{.*}}, align 2

HloModule PadToStaticF16, is_scheduled=true

ENTRY main {
  %param = f16[<=5] parameter(0)
  ROOT %pad_to_static = (f16[5], s32[])
             custom-call(f16[<=5] %param),
             custom_call_target="PadToStatic"
}

// -----

// An operand marked not invariant is neither noalias nor readonly, so it gets
// no ld.global.nc even after function-attrs runs.

// CHECK-LABEL: @pad_to_static_not_invariant(
// CHECK-SAME:    ptr align 16 dereferenceable(14) %{{.*}}, ptr noalias align 256 dereferenceable(10) %{{.*}}, ptr noalias align 256 dereferenceable(4) %{{.*}})
// PTX-LABEL:     .visible .entry pad_to_static_not_invariant(
// PTX-NOT:       ld.global.nc
// PTX:           ld.global.b16
// PTX:           ret;

HloModule PadToStaticNotInvariant, is_scheduled=true

ENTRY main {
  %param = f16[<=5] parameter(0)
  ROOT %pad_to_static_not_invariant = (f16[5], s32[])
             custom-call(f16[<=5] %param),
             custom_call_target="PadToStatic",
             frontend_attributes={xla.no_invariant_operands="0"}
}

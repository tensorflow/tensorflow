// RUN: %if !IS_ROCM %{ hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_target_config_filename=%S/../target_config/specs/a100_pcie_80.txtpb --xla_gpu_experimental_enable_triton_scan=true | FileCheck %s --check-prefix=CHECK-A100 %}
// RUN: %if !IS_ROCM %{ hlo-opt %s --platform=gpu --stage=ptx --xla_gpu_target_config_filename=%S/../target_config/specs/%{GPU}.txtpb --xla_gpu_experimental_enable_triton_scan=true | FileCheck %s %}

// Checks that a bf16 cumulative sum compiles to a Triton scan kernel. Before
// Hopper, FloatNormalization wraps the bf16 add of the combiner in converts
// after ScanRewriterTriton has created the Triton scan fusion.

// CHECK-A100: %[[SUM:.*]] = f32[] add(
// CHECK-A100: bf16[] convert(%[[SUM]])
// CHECK-A100: scan(
// CHECK-A100: fusion({{.*}}"kind":"__triton"

// CHECK: .visible .entry triton_scan(

HloModule cumsum

add {
  x = bf16[] parameter(0)
  y = bf16[] parameter(1)
  sum = bf16[] add(x, y)
  ROOT t = (bf16[], bf16[]) tuple(sum, sum)
}

ENTRY main {
  input = bf16[1024] parameter(0)
  init = bf16[] constant(0)
  scan = (bf16[1024], bf16[]) scan(input, init), dimensions={0}, num_carries=1, is_associative=true, to_apply=add
  ROOT output = bf16[1024] get-tuple-element(scan), index=0
}

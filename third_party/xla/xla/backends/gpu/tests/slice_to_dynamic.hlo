// RUN: hlo-opt %s --platform=gpu --stage=llvm-before-optimizations --xla_gpu_target_config_filename=%S/../target_config/specs/%{GPU}.txtpb --split-input-file | FileCheck --check-prefixes=CHECK,CHECK-%{PTX} %s
// RUN: hlo-opt %s --platform=gpu --stage=llvm-before-optimizations --xla_gpu_target_config_filename=%S/../target_config/specs/%{GPU}.txtpb --split-input-file | FileCheck --check-prefix=NOINV %s

// Loads are not invariant over the whole program.
// NOINV-NOT: !invariant.load

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// CHECK-LABEL: @custom_call(
// CHECK-SAME:    ptr noalias readonly align 16 dereferenceable(32) %[[SRC:.*]], ptr noalias readonly align 256 dereferenceable(4) %[[DIM0_PTR:.*]], ptr noalias readonly align 256 dereferenceable(4) %[[DIM1_PTR:.*]], ptr noalias readonly align 256 dereferenceable(4) %{{.*}}, ptr noalias align 256 dereferenceable(44) %[[OUT:.*]])
// CHECK:         %[[DIM0:.*]] = load i32, ptr %{{.*}}, align 4
// CHECK:         %[[DIM1:.*]] = load i32, ptr %{{.*}}, align 4
// CHECK-PTX:     %[[TID:.*]] = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()
// CHECK-GCN:     %[[TID:.*]] = call i32 @llvm.amdgcn.workitem.id.x()
// CHECK-PTX:     %[[BID:.*]] = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()
// CHECK-GCN:     %[[BID:.*]] = call i32 @llvm.amdgcn.workgroup.id.x()
// CHECK:         %[[IS_T0:.*]] = icmp eq i32 %[[TID]], 0
// CHECK:         br i1 %[[IS_T0]], label %[[T0_BB:.*]], label %[[AFTER_T0_BB:.*]]
// CHECK:       [[T0_BB]]:
// CHECK:         %[[OUT_INT:.*]] = ptrtoint ptr %[[OUT]] to i64
// CHECK:         %[[OFF0:.*]] = add i64 %[[OUT_INT]], 32
// CHECK:         %[[PTR0:.*]] = inttoptr i64 %[[OFF0]] to ptr
// CHECK:         store i32 %[[DIM0]], ptr %[[PTR0]], align 4
// CHECK:         %[[OFF1:.*]] = add i64 %[[OUT_INT]], 36
// CHECK:         %[[PTR1:.*]] = inttoptr i64 %[[OFF1]] to ptr
// CHECK:         store i32 %[[DIM1]], ptr %[[PTR1]], align 4
// CHECK:         %[[OFF2:.*]] = add i64 %[[OUT_INT]], 40
// CHECK:         %[[PTR2:.*]] = inttoptr i64 %[[OFF2]] to ptr
// CHECK:         store i32 %[[DIM0]], ptr %[[PTR2]], align 4
// CHECK:         br label %[[AFTER_T0_BB]]
// CHECK:       [[AFTER_T0_BB]]:
// CHECK:         %[[MUL01:.*]] = mul i32 %[[DIM0]], %[[DIM1]]
// CHECK:         %[[TOTAL:.*]] = mul i32 %[[MUL01]], %[[DIM0]]
// CHECK:         %[[BID_OFF:.*]] = mul i32 %[[BID]], 8
// CHECK:         %[[LIN:.*]] = add i32 %[[BID_OFF]], %[[TID]]
// CHECK:         %[[IN_DYN:.*]] = icmp ult i32 %[[LIN]], %[[TOTAL]]
// CHECK:         br i1 %[[IN_DYN]], label %[[COPY_BB:.*]], label %[[EXIT_BB:.*]]
// CHECK:       [[COPY_BB]]:
// CHECK:         %[[D2:.*]] = urem i32 %[[LIN]], %[[DIM0]]
// CHECK:         %[[Q1:.*]] = udiv i32 %[[LIN]], %[[DIM0]]
// CHECK:         %[[D0:.*]] = urem i32 %[[Q1]], %[[DIM0]]
// CHECK:         %[[D1:.*]] = udiv i32 %[[Q1]], %[[DIM0]]
// CHECK:         %[[SRC_D0_MUL:.*]] = mul i32 %[[D0]], 2
// CHECK:         %[[SRC_D1_MUL:.*]] = mul i32 %[[D1]], 4
// CHECK:         %[[SRC_OFF0:.*]] = add i32 %[[SRC_D0_MUL]], %[[SRC_D1_MUL]]
// CHECK:         %[[SRC_OFF:.*]] = add i32 %[[SRC_OFF0]], %[[D2]]
// CHECK:         %[[SRC_PTR:.*]] = getelementptr inbounds [8 x i32], ptr %[[SRC]], i32 0, i32 %[[SRC_OFF]]
// CHECK:         %[[VAL:.*]] = load i32, ptr %[[SRC_PTR]], align 4
// CHECK:         %[[OUT_PTR:.*]] = getelementptr inbounds [8 x i32], ptr %[[OUT]], i32 0, i32 %[[LIN]]
// CHECK:         store i32 %[[VAL]], ptr %[[OUT_PTR]], align 4
// CHECK:         br label %[[EXIT_BB]]
// CHECK:       [[EXIT_BB]]:
// CHECK:         ret void

HloModule SliceToDynamic, is_scheduled=true

ENTRY main {
  %param = s32[2,2,2]{2,0,1} parameter(0)
  %static = s32[] constant(2)
  %dynamic = s32[] constant(1)
  ROOT %custom-call = s32[2,<=2, 2]{2,0,1} custom-call(s32[2,2,2]{2,0,1} %param,
                                                  s32[] %static,
                                                  s32[] %dynamic,
                                                  s32[] %static),
                                      custom_call_target="SliceToDynamic",
                                      backend_config=""
}

// -----

// Duplicate operands share a slice, so marking either one not invariant drops
// noalias and readonly on both.

// CHECK-LABEL: @slice_shared_not_invariant(
// CHECK-SAME:    ptr noalias readonly align 16 dereferenceable(32) %{{.*}}, ptr align 16 dereferenceable(4) %{{.*}}, ptr noalias readonly align 256 dereferenceable(4) %{{.*}}, ptr align 16 dereferenceable(4) %{{.*}}, ptr noalias align 256 dereferenceable(44) %{{.*}})

HloModule SliceToDynamicSharedNotInvariant, is_scheduled=true

ENTRY main {
  %param = s32[2,2,2]{2,0,1} parameter(0)
  %s = s32[] parameter(1)
  %dynamic = s32[] constant(1)
  ROOT %slice_shared_not_invariant = s32[2,<=2, 2]{2,0,1} custom-call(
      s32[2,2,2]{2,0,1} %param, s32[] %s, s32[] %dynamic, s32[] %s),
      custom_call_target="SliceToDynamic",
      frontend_attributes={xla.no_invariant_operands="3"},
      backend_config=""
}

# --- Rationale ---
#
# Bazel, by default, retries transient remote-execution failures five times
# using exponential backoff, at roughly 100ms, 200ms, 400ms, 800ms, and 1.6s.
#
# Java normally caches a failed DNS lookup for 10 seconds, causing all of those
# retries to receive the same cached failure.
#
# To work around this:
# - Keep successful DNS lookups longer to bridge occasional, brief resolver
#   outages.
# - Allow Bazel's remote retries to retry failed lookups much quicker
#   instead of using the JVM's default ten-second negative cache.

# Up from 30 seconds
networkaddress.cache.ttl=60
# Down from 10 seconds
networkaddress.cache.negative.ttl=1

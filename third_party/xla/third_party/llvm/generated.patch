+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes='require<profile-summary>,function(chr)' -S %s | FileCheck %s
+
+; The outer scope hoists %a to entry because it is the condition of %b.
+; The inner scope must not split head at the now-hoisted %a or specialize it
+; outside the region guarded by the inner scope's merged branch.
+define void @hoisted_insert_point() !prof !12 {
+; CHECK-LABEL: define void @hoisted_insert_point(
+; CHECK-SAME: ) !prof [[PROF12:![0-9]+]] {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[A:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13:![0-9]+]]
+; CHECK-NEXT:    [[TMP0:%.*]] = xor i1 true, [[A]]
+; CHECK-NEXT:    [[TMP1:%.*]] = select i1 true, i1 [[TMP0]], i1 false, !prof [[PROF14:![0-9]+]]
+; CHECK-NEXT:    [[TMP2:%.*]] = select i1 [[TMP1]], i1 true, i1 false, !prof [[PROF14]]
+; CHECK-NEXT:    br i1 [[TMP2]], label %[[ENTRY_SPLIT:.*]], label %[[ENTRY_SPLIT_NONCHR:.*]], !prof [[PROF15:![0-9]+]]
+; CHECK:       [[ENTRY_SPLIT]]:
+; CHECK-NEXT:    br label %[[HEAD:.*]]
+; CHECK:       [[HEAD]]:
+; CHECK-NEXT:    br i1 false, label %[[SIDE:.*]], label %[[EXIT:.*]], !prof [[PROF13]]
+; CHECK:       [[SIDE]]:
+; CHECK-NEXT:    br label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    [[B:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    [[C:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    ret void
+; CHECK:       [[ENTRY_SPLIT_NONCHR]]:
+; CHECK-NEXT:    br label %[[HEAD_NONCHR:.*]]
+; CHECK:       [[HEAD_NONCHR]]:
+; CHECK-NEXT:    [[A_NONCHR:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    br i1 false, label %[[SIDE_NONCHR:.*]], label %[[EXIT_NONCHR:.*]], !prof [[PROF13]]
+; CHECK:       [[SIDE_NONCHR]]:
+; CHECK-NEXT:    br label %[[EXIT_NONCHR]]
+; CHECK:       [[EXIT_NONCHR]]:
+; CHECK-NEXT:    [[B_NONCHR:%.*]] = select i1 [[A_NONCHR]], i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    [[C_NONCHR:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %head
+head:
+  %a = select i1 false, i1 false, i1 false, !prof !13
+  br i1 false, label %side, label %exit, !prof !13
+side:
+  br label %exit
+exit:
+  %b = select i1 %a, i1 false, i1 false, !prof !13
+  %c = select i1 false, i1 false, i1 false, !prof !13
+  ret void
+}
+
+; A select other than the insertion point can also be hoisted. Preserve its
+; condition: specializing it would change the outer scope's branch condition.
+define i1 @hoisted_later_select() !prof !12 {
+; CHECK-LABEL: define i1 @hoisted_later_select(
+; CHECK-SAME: ) !prof [[PROF12]] {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[A:%.*]] = select i1 true, i1 true, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    [[TMP0:%.*]] = xor i1 true, [[A]]
+; CHECK-NEXT:    [[TMP1:%.*]] = select i1 true, i1 [[TMP0]], i1 false, !prof [[PROF14]]
+; CHECK-NEXT:    [[TMP2:%.*]] = select i1 [[TMP1]], i1 true, i1 false, !prof [[PROF14]]
+; CHECK-NEXT:    br i1 [[TMP2]], label %[[ENTRY_SPLIT:.*]], label %[[ENTRY_SPLIT_NONCHR:.*]], !prof [[PROF15]]
+; CHECK:       [[ENTRY_SPLIT]]:
+; CHECK-NEXT:    br label %[[HEAD:.*]]
+; CHECK:       [[HEAD]]:
+; CHECK-NEXT:    [[KEEP:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    br i1 false, label %[[SIDE:.*]], label %[[EXIT:.*]], !prof [[PROF13]]
+; CHECK:       [[SIDE]]:
+; CHECK-NEXT:    br label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    [[B:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    [[C:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    ret i1 [[A]]
+; CHECK:       [[ENTRY_SPLIT_NONCHR]]:
+; CHECK-NEXT:    br label %[[HEAD_NONCHR:.*]]
+; CHECK:       [[HEAD_NONCHR]]:
+; CHECK-NEXT:    [[KEEP_NONCHR:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    [[A_NONCHR:%.*]] = select i1 true, i1 true, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    br i1 false, label %[[SIDE_NONCHR:.*]], label %[[EXIT_NONCHR:.*]], !prof [[PROF13]]
+; CHECK:       [[SIDE_NONCHR]]:
+; CHECK-NEXT:    br label %[[EXIT_NONCHR]]
+; CHECK:       [[EXIT_NONCHR]]:
+; CHECK-NEXT:    [[B_NONCHR:%.*]] = select i1 [[A_NONCHR]], i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    [[C_NONCHR:%.*]] = select i1 false, i1 false, i1 false, !prof [[PROF13]]
+; CHECK-NEXT:    ret i1 [[A_NONCHR]]
+;
+entry:
+  br label %head
+head:
+  %keep = select i1 false, i1 false, i1 false, !prof !13
+  %a = select i1 true, i1 true, i1 false, !prof !13
+  br i1 false, label %side, label %exit, !prof !13
+side:
+  br label %exit
+exit:
+  %b = select i1 %a, i1 false, i1 false, !prof !13
+  %c = select i1 false, i1 false, i1 false, !prof !13
+  ret i1 %a
+}

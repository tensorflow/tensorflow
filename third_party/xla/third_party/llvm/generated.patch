-  MoreConstrainedPostfix<int> b = i--;
-  MoreConstrainedPostfix<short> s{1};
-  MoreConstrainedPostfix<short> c = s++;
-  MoreConstrainedPostfix<short> d = s--;
-  return a.v * 100000 + b.v * 10000 + i.v * 1000 + c.v * 100 + d.v * 10 + s.v;

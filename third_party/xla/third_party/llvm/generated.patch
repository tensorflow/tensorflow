+; RUN: opt -thinlto-bc a.ll -o a.o
+; RUN: opt -thinlto-bc b.ll -o b.o
+; RUN: opt -thinlto-bc c.ll -o c.o
+; RUN: opt -thinlto-bc d.ll -o d.o
+; RUN: opt -thinlto-bc e.ll -o e.o

+      lhs_dilate = [7]
+    } {batch_group_count = 1 : i64, feature_group_count = 1 : i64, sdy.sharding = #sdy.sharding_per_value<[<@mesh_4_2, [{}, {}, {}]>]>}
+    : (tensor<1x7x16xf32>, tensor<7x16x32xf32>) -> tensor<1x7x32xf32>
+  return %conv_out : tensor<1x7x32xf32>

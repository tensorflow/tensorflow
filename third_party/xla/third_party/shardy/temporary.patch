+// CHECK-LABEL: func @gather_batch_2d_with_sharding_constraint_and_negative_index_select
+// CHECK-SAME: (%[[OPERAND:.*]]: tensor<4x8xf32>, %[[COL_IDX:.*]]: tensor<4x1xi32>) -> tensor<4xf32>
+func.func @gather_batch_2d_with_sharding_constraint_and_negative_index_select(
+    %operand: tensor<4x8xf32>, %col_idx: tensor<4x1xi32>) -> tensor<4xf32> {
+  // CHECK-NEXT: %[[COL_SC:.*]] = sdy.sharding_constraint %[[COL_IDX]] <@mesh, [{"x"}, {}]> : tensor<4x1xi32>

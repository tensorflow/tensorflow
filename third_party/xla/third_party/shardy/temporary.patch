+  ]> : tensor<5x2xf32>
+
+  %seq_add = func.call @sequential_scatter_add_nonzero_padded_updates(%in_f32, %idx_i32, %upd_f32)
+      : (tensor<6x2xf32>, tensor<5x1xi32>, tensor<5x2xf32>) -> tensor<6x2xf32>
+  %res_add:4 = "interpreter.run_parallel"(

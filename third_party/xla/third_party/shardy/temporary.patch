+  %c4 = stablehlo.constant dense<4> : tensor<i32>
+  %5 = stablehlo.broadcast_in_dim %c4, dims = [] : (tensor<i32>) -> tensor<4xi32>
+  %6 = sdy.sharding_constraint %5 <@mesh, [{"x"}]> : tensor<4xi32>
+  %7 = stablehlo.add %1, %6 : tensor<4xi32>
+  %8 = sdy.sharding_constraint %7 <@mesh, [{"x"}]> : tensor<4xi32>

+  %1 = stablehlo.pad %0, %cst, low = [1, 0], high = [1, 0], interior = [0, 0] {sdy.sharding = #sdy.sharding_per_value<[<@mesh_x2_y2, [{"x"}, {}]>]>} : (tensor<3x2xf32>, tensor<f32>) -> tensor<5x2xf32>
+  return %1 : tensor<5x2xf32>

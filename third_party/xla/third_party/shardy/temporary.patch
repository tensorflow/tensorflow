+  %t2 = stablehlo.slice %input [0:3, 0:4, 20:40] : (tensor<3x8x40xi32>) -> tensor<3x4x20xi32>
+  %t3 = stablehlo.slice %input [0:3, 4:8, 20:40] : (tensor<3x8x40xi32>) -> tensor<3x4x20xi32>

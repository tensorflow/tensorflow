+    Value localInput = adaptor.getTensor();
+    auto localInputType = cast<RankedTensorType>(localInput.getType());
+    auto localResultType = cast<RankedTensorType>(converter->convertType(op));
+    if (!localResultType.hasStaticShape()) {

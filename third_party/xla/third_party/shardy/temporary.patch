diff --git a/shardy/dialect/sdy/transforms/export/test/executable_convert_global_to_local/sdy_replicated_to_unreduced.mlir b/shardy/dialect/sdy/transforms/export/test/executable_convert_global_to_local/sdy_replicated_to_unreduced.mlir

+  // CHECK-NEXT: %[[PAD1:.*]] = stablehlo.pad %[[ARG1]], %[[CST1]], low = [0, 0, 0], high = [1, 0, 0], interior = [0, 0, 0] : (tensor<7x16x32xf32>, tensor<f32>) -> tensor<8x16x32xf32>

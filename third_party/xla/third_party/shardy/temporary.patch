+  %12 = sdy.sharding_constraint %11 <@mesh, [{"x"}, {}]> : tensor<4x1xi32>
+  %13 = stablehlo.concatenate %12, %col_idx, dim = 1 : (tensor<4x1xi32>, tensor<4x1xi32>) -> tensor<4x2xi32>
+  %14 = sdy.sharding_constraint %13 <@mesh, [{"x"}, {}]> : tensor<4x2xi32>
+  %15 = "stablehlo.scatter"(%operand, %14, %updates) <{

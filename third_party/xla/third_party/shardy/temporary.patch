+  %s11 = "stablehlo.slice"(%input_2d) {start_indices=array<i64: 2, 2, 0>, limit_indices=array<i64: 4, 4, 4>, strides=array<i64: 1, 1, 1>} : (tensor<4x4x4xi32>) -> tensor<2x2x4xi32>

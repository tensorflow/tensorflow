# hwloc: Portable Hardware Locality Library

load("@rules_cc//cc:cc_library.bzl", "cc_library")

licenses(["notice"])

filegroup(
    name = "COPYING",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "hwloc",
    linkopts = ["-lhwloc"],
    visibility = ["//visibility:public"],
)

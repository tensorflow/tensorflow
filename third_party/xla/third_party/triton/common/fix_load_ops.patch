     if (Value remat = existingRemats.lookup({value, encoding}))
       mapping.map(value, remat);
+    else if (auto tensorType = dyn_cast<RankedTensorType>(value.getType());
+             tensorType && tensorType.getEncoding() == encoding)
+      mapping.map(value, value);
   }
 
   SetVector<Operation *> opsToRewrite;

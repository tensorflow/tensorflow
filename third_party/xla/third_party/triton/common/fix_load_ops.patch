@@ -1083,6 +1083,24 @@ struct AsyncCopyGlobalToLocalOpConversion
       auto srcElem = b.extract_val(ptrTy, structElem, 0);
       auto maskElem = b.extract_val(i1_ty, structElem, 1);
 
+      if (l2PolicyReg && computeCapability >= 90) {
+        // On SM90+, ptxas miscompiles cp.async with L2::cache_hint when the
+        // shared memory address is matched as [R_thread + UR_uniform] (opcode
+        // 0x7dae), overwriting the low 32 bits of the 64-bit createpolicy
+        // uniform register pair and emitting an invalid odd descriptor register
+        // desc[UR(2k+1)] that faults with CUDA_ERROR_ILLEGAL_INSTRUCTION.
+        // Materializing the shared memory address through lop3.b32 prevents
+        // ptxas from decomposing it into [R + UR], forcing the valid [R],
+        // desc[UR(2k)] encoding (opcode 0x7fae).
+        PTXBuilder addrBuilder;
+        auto *outAddr = addrBuilder.newOperand("=r");
+        auto *inAddr = addrBuilder.newOperand(shmemAddr, "r");
+        (*addrBuilder.create<>("lop3.b32"))(
+            outAddr, inAddr, inAddr, inAddr,
+            addrBuilder.newConstantOperand(0xF0));
+        shmemAddr = addrBuilder.launch(rewriter, loc, i32_ty);
+      }
+
       PTXBuilder ptxBuilder;
       auto &copyAsyncOp =

@@ -1060,7 +1060,7 @@ struct AsyncCopyGlobalToLocalOpConversion
         l2PrefetchSizeAttr ? l2PrefetchSizeAttr.getInt() : 0;
 
     auto emitCpAsync = [&b, threadPred, ptrTy, l2PolicyReg, l2PrefetchSize,
-                        cacheModifier = cachePolicy->modifier,

+static LogicalResult readCachePolicyProp(DialectBytecodeReader &reader,
+                                         Attribute &policy) {
+  if (failed(reader.readOptionalAttribute(policy)))
+    return failure();
+  if (auto cache = dyn_cast_or_null<IntegerAttr>(policy)) {
+    IntegerAttr evict;
+    if (failed(reader.readOptionalAttribute(evict)) || !evict)
+      return failure();
+    auto cm =
+        symbolizeCacheModifier(cache.getInt()).value_or(CacheModifier::NONE);
+    auto ep =
+        symbolizeEvictionPolicy(evict.getInt()).value_or(EvictionPolicy::NORMAL);
+    policy = (cm == CacheModifier::NONE && ep == EvictionPolicy::NORMAL)
+                 ? Attribute()
+                 : CachePolicyAttr::get(cache.getContext(), cm, ep);
+  }
+  return success();
+}
+
 //-- LoadOp --
+LogicalResult LoadOp::readProperties(DialectBytecodeReader &reader,
+                                     OperationState &state) {
+  auto &prop = state.getOrAddProperties<Properties>();
+  return failure(
+      failed(readCachePolicyProp(reader, prop.cachePolicy)) ||
+      failed(reader.readOptionalAttribute(prop.isVolatile)) ||
+      failed(reader.readSparseArray(MutableArrayRef(prop.operandSegmentSizes))));
+}
+
+void LoadOp::writeProperties(DialectBytecodeWriter &writer) {
+  auto &prop = getProperties();
+  writer.writeOptionalAttribute(prop.cachePolicy);
+  writer.writeOptionalAttribute(prop.isVolatile);
+  writer.writeSparseArray(ArrayRef(prop.operandSegmentSizes));
+}

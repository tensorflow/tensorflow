diff --git a/lib/Conversion/TensorToCudaTile/TensorToCudaTile.cpp b/lib/Conversion/TensorToCudaTile/TensorToCudaTile.cpp
--- a/lib/Conversion/TensorToCudaTile/TensorToCudaTile.cpp
+++ b/lib/Conversion/TensorToCudaTile/TensorToCudaTile.cpp
@@ -56,6 +56,10 @@
     // Convert tensor types to 0-D tiles, as the actual tile shape is not
     // available during the type conversion (depends on the iteration space).
     addConversion([=](RankedTensorType tensorTy) -> Type {
+      if (isa<Float4E2M1FNType>(tensorTy.getElementType())) {
+        return cuda_tile::TileType::get(/*shape=*/llvm::ArrayRef<int64_t>{2},
+                                        tensorTy.getElementType());
+      }
       return convertType(tensorTy.getElementType());
     });
   }

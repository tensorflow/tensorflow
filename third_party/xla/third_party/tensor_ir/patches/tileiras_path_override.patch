+/// Overrides the 'tileiras' executable that assembleTileIRToCubin() invokes
+/// and the environment it runs in. By default the assembler is searched for in
+/// options.codegen.tileirasPath, getCudaToolkitPath()/bin, and PATH, and
+/// inherits the environment of the calling process, which a host that stages
+/// its tools in a private directory cannot arrange. An empty path restores the
+/// default lookup; an empty environment restores inheritance. Environment
+/// entries are "NAME=value" strings.
+void setTileIRAssembler(llvm::StringRef path,
+                        llvm::ArrayRef<std::string> environment = {});
 
 /// Assemble TileIR bytecode for the target, checking bytecodeVersion if given.

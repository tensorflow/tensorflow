+void mlir::nv_tensor_ir::backend::cuda_tile::setTileIRAssembler(
+    llvm::StringRef path, llvm::ArrayRef<std::string> environment) {
+  std::lock_guard<std::mutex> lock(assemblerOverrideMutex());

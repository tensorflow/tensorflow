op {
  graph_op_name: "StatelessRandomBinomial"
  visibility: HIDDEN
  in_arg {
    name: "shape"
    description: <<END
The shape of the output tensor.
END
  }
  in_arg {
    name: "seed"
    description: <<END
2 seeds (shape [2]).
END
  }
  in_arg {
    name: "counts"
    description: <<END
Nonnegative, integer-valued trial counts. Must be broadcastable with `probs`
and the rightmost dimensions of `shape`.
END
  }
  in_arg {
    name: "probs"
    description: <<END
Success probabilities in `[0, 1]`. Must be broadcastable with `counts` and the
rightmost dimensions of `shape`.
END
  }
  out_arg {
    name: "output"
    description: <<END
Random values with specified shape.
END
  }
  attr {
    name: "dtype"
    description: <<END
The type of the output.
END
  }
  summary: "Outputs deterministic pseudorandom random numbers from a binomial distribution."
  description: <<END
Outputs random values from a binomial distribution.

The outputs are a deterministic function of `shape`, `seed`, `counts`, and `probs`.

Values outside the stated domains for `counts` and `probs` are not
necessarily rejected.
END
}

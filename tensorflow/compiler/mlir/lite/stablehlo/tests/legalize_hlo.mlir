// CHECK:           %[[VAL_6:.*]] = "tf.Equal"(%[[VAL_5]], %[[VAL_0]]) <{incompatible_shape_error = true}> : (tensor<i32>, tensor<i32>) -> tensor<i1>
// CHECK:           return %[[VAL_5]] : tensor<i32>
// CHECK:         }
func.func @remove_shape_assertion_custom_call(%arg1: tensor<?x5xi32>) -> tensor<i32> {
  %0 = stablehlo.constant dense<3> : tensor<i32>
  %1 = "stablehlo.get_dimension_size"(%arg1) <{dimension = 0 : i64}> : (tensor<?x5xi32>) -> tensor<i32>
  %ok = stablehlo.compare  EQ, %1, %0,  SIGNED : (tensor<i32>, tensor<i32>) -> tensor<i1>

// CHECK:           %[[VAL_3:.*]] = "tf.Less"(%[[ARG1]], %[[VAL_2]]) : (tensor<2x3xi32>, tensor<2x3xi32>) -> tensor<2x3xi1>
// CHECK:           %[[VAL_4:.*]] = "tf.Equal"(%[[VAL_1]], %[[VAL_3]]) <{incompatible_shape_error = true}> : (tensor<3xi1>, tensor<2x3xi1>) -> tensor<2x3xi1>
// CHECK:           %[[VAL_5:.*]] = "tf.Div"(%[[ARG0]], %[[ARG1]]) : (tensor<3xi32>, tensor<2x3xi32>) -> tensor<2x3xi32>
// CHECK:           %[[VAL_6:.*]] = "tf.Abs"(%[[ARG0]]) : (tensor<3xi32>) -> tensor<3xi32>
// CHECK:           %[[VAL_7:.*]] = "tf.Abs"(%[[ARG1]]) : (tensor<2x3xi32>) -> tensor<2x3xi32>
// CHECK:           %[[VAL_8:.*]] = "tf.Const"() <{value = dense<1> : tensor<2x3xi32>}> : () -> tensor<2x3xi32>
// CHECK:           %[[VAL_9:.*]] = "tf.Sub"(%[[VAL_7]], %[[VAL_8]]) : (tensor<2x3xi32>, tensor<2x3xi32>) -> tensor<2x3xi32>
// CHECK:           %[[VAL_10:.*]] = "tf.AddV2"(%[[VAL_6]], %[[VAL_9]]) : (tensor<3xi32>, tensor<2x3xi32>) -> tensor<2x3xi32>
// CHECK:           %[[VAL_11:.*]] = "tf.Neg"(%[[VAL_10]]) : (tensor<2x3xi32>) -> tensor<2x3xi32>
// CHECK:           %[[VAL_12:.*]] = "tf.Abs"(%[[ARG1]]) : (tensor<2x3xi32>) -> tensor<2x3xi32>
// CHECK:           %[[VAL_13:.*]] = "tf.Div"(%[[VAL_11]], %[[VAL_12]]) : (tensor<2x3xi32>, tensor<2x3xi32>) -> tensor<2x3xi32>
// CHECK:           %[[VAL_14:.*]] = "tf.Select"(%[[VAL_4]], %[[VAL_5]], %[[VAL_13]]) : (tensor<2x3xi1>, tensor<2x3xi32>, tensor<2x3xi32>) -> tensor<2x3xi32>
